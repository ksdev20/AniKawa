---
import "./anime-card2.css";
import AnimeWBtn from "../AnimeCard/AnimeWBtn";
import { thisYearTopByCategory } from "../../filters/animeFilterMainTmdbVer";

const category: string = Astro.props.category;
const usedTitlesAC2: string[] = Astro.props.usedTitlesAC2;

const anime: any = thisYearTopByCategory(category, usedTitlesAC2);
if (!anime) return null;
const { nanoid, slug } = anime;
const epSlug = anime?.episodes?.[0]?.slug ?? "n-a";
const { title, description, poster } = anime ?? {};
const language = 'Subtitled';
---

<section class="wrapper">
    <a href={`/show/${nanoid}/${slug}`}
        ><img
            class="anime-card-2-image"
            src={poster}
            loading="lazy"
            decoding="async"
            alt={`Cover of ${title}`}
        /></a
    >
    <div class="anime-card-2-details">
        <a href={`/show/${nanoid}/${slug}`}
            ><h2 class="anime-card-2-heading">{title}</h2></a
        >
        <div class="anime-card-sub-dub">{language}</div>
        <p class="anime-card-2-para" set:html={description} />
        <div class="anime-card-2-btn-section">
            <a
                href={`/episode/${nanoid}/${epSlug}`}
                class="start-watching-btn card-2"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    height="28px"
                    viewBox="0 -960 960 960"
                    width="28px"
                    fill="#000000"
                    ><path
                        d="M320-200v-560l440 280-440 280Zm80-280Zm0 134 210-134-210-134v268Z"
                    ></path></svg
                >
                START WATCHING S1 E1
            </a>
            <AnimeWBtn client:load nanoid={nanoid} forAC2={true} />
        </div>
    </div>
</section>
