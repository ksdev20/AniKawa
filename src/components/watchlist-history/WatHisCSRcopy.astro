---
import "../../styles/config.css";
import "./wat-his.css";
import '../../styles/NewPopALStyles.css';
import SortBtnHandler from "../ButtonHandlers/SortBtnHandler";
import {
    getWatchlistItems,
    getHistoryItems,
} from "../../filters/wat-his-match-logic";
import AnimeCardStatic from "../AnimeCard/AnimeCardStaticTmdbVer.astro";
import { type Anime, type Episode } from "../../filters/mergedListTypes";
import EpisodeCardStatic from "../EpisodeCard/EpisodeCardStatic.astro";
import ClearHisBtn from "./ClearHisBtn";
import AnimeCardStaticTmdbVer from "../AnimeCard/AnimeCardStaticTmdbVer.astro";
const backendUrl = import.meta.env.PUBLIC_BACKEND_URL;

const caller = Astro.props.caller;
const sort = Astro.url.searchParams.get('sort') ?? 'new';
const forWatchlist = caller == "w";
const field = forWatchlist ? "watchlist" : "history";

let watchlist: Anime[] = [];
let history: Episode[] = [];
let listEmpty = false;

try {
    const res = await fetch(
        `${backendUrl}/api/getList?field=${field}`,
        {
            method: "GET",
            headers: {
                Cookie: Astro.request.headers.get("cookie") || "",
            },
        },
    );

    if (!res) throw new Error("Response invalid.");

    const data = await res.json();
    if (!res) throw new Error("Data invalid.");

    if (data.success) {
        if (data.data.length == 0) {
            listEmpty = true;
        } else {
            const titleList = data.data;
            // let enrichedList;
            // if (forWatchlist){
            //     enrichedList = getWatchlistItems(titleList);
            //     watchlist = enrichedList;
            // }else {
            //     enrichedList = getHistoryItems(titleList);
            //     history = enrichedList;
            // }s
            const enrichedList = forWatchlist
                ? getWatchlistItems(titleList)
                : getHistoryItems(titleList);
            forWatchlist
                ? (watchlist = enrichedList)
                : (history = enrichedList);
            
            if (sort == 'new') watchlist.reverse();
        }
    } else {
        data.error ? console.error(data.error) : console.error("Unknown error");
    }
} catch (e) {
    console.error("Error :", e);
}
---

<main class="profile-main">
    <section class="wat-his-main-box">
        <div class="wh-top">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                height="38px"
                viewBox="0 -960 960 960"
                width="38px"
                fill="#ffffff"
            >
                <path
                    d="M200-120v-640q0-33 23.5-56.5T280-840h400q33 0 56.5 23.5T760-760v640L480-240 200-120Zm80-122 200-86 200 86v-518H280v518Zm0-518h400-400Z"
                ></path>
            </svg>
            <h1 style={{ fontSize: "30px" }}>My Lists</h1>
        </div>
        <nav class="buttons-section">
            <a
                class={`wh-btn ${caller == "w" ? "active" : ""}`}
                href={`${caller == 'h' ? "/watchlist" : 'javascript:void(0)'}`}
                aria-label="Watchlist page"
                >WATCHLIST</a
            >
            <a class={`wh-btn ${caller == "h" ? "active" : ""}`} href={`${caller == 'w' ? "/history" : 'javascript:void(0)'}`}
                aria-label="History page"
                >HISTORY</a
            >
        </nav>
        <section
            class={`wat-his-main-box watchlist-main ${caller == "w" && !listEmpty ? "active" : ""}`}
        >
            <header class="wh-top-bar">
                <h2 class="left-heading">{sort == 'new' ? 'Recently Added' : 'Oldest added'}</h2>
                <div id="sort-btn-wat" class="new-first-right part">
                    <SortBtnHandler watHisAsking={true} givenSort={sort} client:load/>
                </div>
            </header>
            <ul id="watchlist-list" class="new-pop-anime-list">
                {
                    forWatchlist &&
                        watchlist.map((anime, i) => (
                            <AnimeCardStaticTmdbVer key={i} anime={anime} fornewpop={true}/>
                        ))
                }
            </ul>
        </section>
        <section
            id="history-main"
            class={`wat-his-main-box history-main ${caller == "h" && !listEmpty ? "active" : ""}`}
        >
            <header class="wm-top hm-top">
                <h2 class="left-heading">Most Recent</h2>
                <ClearHisBtn client:load />
            </header>
            <ul id="history-list" class="episodes-list el-history">
                {
                    !forWatchlist &&
                        history.slice().reverse().map((epData) => <EpisodeCardStatic epData={epData} forHistory={true}/>)
                }
            </ul>
        </section>
        <div id="empty-wh" class={`empty-wh ${listEmpty ? 'active' : ''}`}>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                height="70px"
                viewBox="0 -960 960 960"
                width="70px"
                fill="#ffffff"
            >
                <path
                    d="M520-400h80v-120h120v-80H600v-120h-80v120H400v80h120v120ZM320-240q-33 0-56.5-23.5T240-320v-480q0-33 23.5-56.5T320-880h480q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H320Zm0-80h480v-480H320v480ZM160-80q-33 0-56.5-23.5T80-160v-560h80v560h560v80H160Zm160-720v480-480Z"
                ></path>
            </svg>
            <p id="watchlist-des" class={`wat-des ${caller == 'w' ? 'active' : ''}`}>
                Nothing is added in your watchlist.Come on let's add some
                amazing anime to watch !
            </p>
            <p id="history-des" class={`wat-des ${caller == 'h' ? 'active' : ''}`}>
                Your history is empty man come on watch something !
            </p>
            <a class="goto-home-btn" href="../index.html">GO TO HOME FEED</a>
        </div>
    </section>
</main>
