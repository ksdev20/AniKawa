---
import "./animecardtw.css";
import { getPosterType } from "../../utils/imageSizing";
import { Icon } from "../../icons/icons";

const { anime, forNewPop = false, forCategory = false } = Astro.props;
if (anime?.episodes?.length == 0) return null;

const {
  nanoid = "n-a",
  slug,
  title = "Untitled",
  description = "No Description",
  season,
  seasons,
  score,
  ratedBy,
  genres,
  number_of_episodes,
  runtime,
  status,
  anikawaReview,
} = anime ?? {};

//cover image fallback
const season_poster =
  anime?.season_poster ??
  anime?.poster ??
  anime?.plThumbnail ??
  "/anime-image-alt.png";

const titleAlt = seasons > 1 ? `Season ${season}: ${title}` : title;
const epLength = number_of_episodes ?? anime?.episodes?.length;
const ep1Nanoid = anime?.episodes?.[0]?.nanoid;
const ep1Slug = anime?.episodes?.[0]?.slug;
const starCount = Math.round(Number(score) / 2);
const verdict = anikawaReview?.verdict ?? null;
const strengths = anikawaReview?.strengths;

const star = "★"
---

<li class={`anime-card ${forNewPop ? "new-pop-ac" : ""}`}>
  <article
    class={`anime-card-first ${forNewPop ? "new-pop-anime-card" : ""} ${forCategory ? "ac-for-cat" : ""}`}
  >
    <a href={`/show/${nanoid}/${slug}`} class="anime-card-link">
      <span class="sr-only">Go to {title} Anime Page</span>
    </a>
    <img
      class="anime-card-image"
      width="342"
      height="513"
      src={getPosterType(season_poster, "w342")}
      srcset={`
  ${getPosterType(season_poster, "w500")} 500w,
  ${getPosterType(season_poster, "w780")} 780w
`}
      sizes="
  (max-width: 600px) 45vw,
  (max-width: 1200px) 18vw,
  180px
"
      alt={`Cover of ${title}`}
      loading="lazy"
      decoding="sync"
    />
    <h2 class="anime-card-title">{titleAlt}</h2>
    <div class="rating-widget">
      <div class="rating-stars">
        <span>{star}</span>
      </div>
      <span class="rating-score">
        {Math.floor(starCount as number)}
      </span>
      <div class="rating-reviews">
        ({ratedBy})
      </div>
    </div>
    <div class="genres-widget">
      {
        genres
          .slice(0, 3)
          .map((genre: string) => <span class="genre-badge">{genre}</span>)
      }
    </div>
    <div class="episodes-status-widget">
      <span class="episodes-count">{epLength} Eps</span>
      {
        !isNaN(parseFloat(runtime[0])) && (
          <span class="episode-duration">
            • {runtime.replace("minutes", "mins")}
          </span>
        )
      }
    </div>

    <section
      class="anime-card-hover"
      style={`background-image: url(${getPosterType(season_poster, "w342")})`}
    >
      <div class="anime-card-hover-details">
        <h3 class="anime-card-hover-title">{titleAlt}</h3>
        <div class="rating-widget">
          <div class="rating-stars">
            <span>{star}</span>
          </div>
          <span class="rating-score">
            {Math.floor(starCount as number)}
          </span>
          <div class="rating-reviews">
            ({ratedBy})
          </div>
        </div>
        <div class="episodes-status-widget">
          <span class="episodes-count">{epLength} Eps</span>
          {
            !isNaN(parseFloat(runtime[0])) && (
              <span class="episode-duration">
                • {runtime.replace("minutes", "mins")}
              </span>
            )
          }
        </div>
        <span class="status-badge">{status}</span>
        {!verdict && <p class="anime-card-hover-description">{description}</p>}
        {verdict && <p class="hover-verdict">Verdict: {verdict}</p>}
        {
          strengths && (
            <h4 class="hover-whywatch-title">Why Watch?</h4>
            <ul class="hover-highlights">
              {strengths.slice(0, 3).map((i: string) => (
                <li>{i}</li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
    <nav class="anime-card-hover-actions">
      <div class="tooltip" data-tip={`Play S${season} E1`}>
        <a
          href={`/episode/${nanoid}/${ep1Nanoid}/${ep1Slug}`}
          aria-label={`Watch ${titleAlt} Episode 1`}
        >
          <Icon name="play" size={40} color="#8c52ff" />
        </a>
      </div>
    </nav>
  </article>
</li>
