---
import "@/styles/components/HomePage/share-anikawa.css";
import { frontendUrl } from "@/global_assets/globalPaths";
import ShareAnikawaCSR from "./ShareAnikawaCSR";

import { ShareNetworkIcon, ArrowUpRightIcon } from "@phosphor-icons/react";

const siteUrl = frontendUrl;

const title = "Discover amazing anime on AniKawa";
const text =
  "🎌 Looking for your next favorite anime? Discover handpicked recommendations, hidden gems, reviews and more on AniKawa.";

const encodedUrl = encodeURIComponent(siteUrl);
const encodedText = encodeURIComponent(text);

const shareLinks = [
  {
    name: "WhatsApp",
    href: `https://wa.me/?text=${encodedText}%20${encodedUrl}`,
  },
  {
    name: "X",
    href: `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`,
  },
  {
    name: "Reddit",
    href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodeURIComponent(title)}`,
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  },
];
---

<section class="share-section" aria-labelledby="share-anikawa-title">
  <div class="share-container">
    <div class="share-card">
      <!-- Decorative glow -->
      <div class="share-card-glow" aria-hidden="true"></div>

      <!-- ============================================================
           ICON
           ============================================================ -->

      <div class="share-icon">
        <ShareNetworkIcon size={25} weight="duotone" aria-hidden="true" />
      </div>

      <!-- ============================================================
           CONTENT
           ============================================================ -->

      <div class="share-content">
        <span class="share-kicker"> Spread the word </span>

        <h2 id="share-anikawa-title" class="share-title">
          Found something
          <span> worth watching?</span>
        </h2>

        <p class="share-subtitle">
          Share AniKawa with another anime fan and help them discover something
          they'll love.
        </p>
      </div>

      <!-- ============================================================
           PRIMARY SHARE
           ============================================================ -->

      <div class="share-action">
        <ShareAnikawaCSR client:load url={siteUrl} />
      </div>

      <!-- ============================================================
           SOCIAL SHORTCUTS
           ============================================================ -->

      <div class="share-social">
        <span class="share-social-label"> Or share on </span>

        <div class="share-buttons">
          {
            shareLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="share-button"
                aria-label={`Share AniKawa on ${social.name}`}
              >
                <span>{social.name}</span>
                <ArrowUpRightIcon size={14} weight="bold" aria-hidden="true" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
