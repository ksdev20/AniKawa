---
import { getNewest15Episodes } from "../../filters/animeFilterMainTmdbVer.ts";
import AnimeSliderCSR from "../AnimeSlider/AnimeSliderCSR";
import EpisodeCardStatic from "../EpisodeCard/EpisodeCardStatic.astro";
import "@/styles/components/HomePage/latest-episodes.css";
import {
  LightningIcon,
  ArrowRightIcon,
  CalendarDotsIcon,
} from "@phosphor-icons/react";

const latestEpisodes = await getNewest15Episodes();
---

<section class="latest-episodes put-margin">
  <div class="latest-episodes-container">
    <!-- ============================================================
         HEADER
         ============================================================ -->

    <header class="latest-episodes-header">
      <div class="latest-episodes-heading">
        <span class="latest-episodes-kicker">
          <LightningIcon size={15} weight="fill" />
          Fresh Releases
        </span>

        <h2 class="latest-episodes-title">
          What's new
          <span> right now.</span>
        </h2>

        <p class="latest-episodes-subtitle">
          The newest episodes added to AniKawa, so you can jump straight into
          what's airing and what's just been released.
        </p>
      </div>

      <a href="/list?sort=newest" class="latest-episodes-link">
        Browse anime
        <ArrowRightIcon size={17} weight="bold" aria-hidden="true" />
      </a>
    </header>

    <!-- ============================================================
         EPISODE RAIL
         ============================================================ -->

    <div class="latest-episodes-slider">
      <div class="latest-episodes-rail">
        <ul class="slider-container">
          {
            latestEpisodes.map((episode: any) => (
              <EpisodeCardStatic epData={episode} />
            ))
          }
        </ul>

        <AnimeSliderCSR client:load />
      </div>
    </div>

    <!-- ============================================================
         CONTEXT
         ============================================================ -->

    <div class="latest-episodes-context">
      <div class="latest-episodes-context-icon">
        <CalendarDotsIcon size={20} weight="duotone" />
      </div>

      <div>
        <h3>Stay caught up</h3>

        <p>
          New episodes are added as they become available, making this a quick
          way to see what's recently arrived on AniKawa.
        </p>
      </div>
    </div>
  </div>
</section>
