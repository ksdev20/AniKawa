---
import "./browse-by-category.css";
---

<section class="browse-categories-section">
  <div class="browse-categories-container">
    <div class="section-header">
      <span class="section-badge"> 🎌 Explore Anime by Genre</span>

      <h2 class="section-title">Browse by Category</h2>

      <p class="section-subtitle">
        Discover anime by genre, theme, and fan-favorite collections.
      </p>
    </div>
    
    <div class="browse-categories-grid">
      <a href="/category/Action" class="browse-category-card">
        <div class="browse-category-icon">⚔️</div>
        <h3 class="browse-category-title">Action</h3>
      </a>

      <a href="/category/Romance" class="browse-category-card">
        <div class="browse-category-icon">💕</div>
        <h3 class="browse-category-title">Romance</h3>
      </a>

      <a href="/category/Isekai" class="browse-category-card">
        <div class="browse-category-icon">🌍</div>
        <h3 class="browse-category-title">Isekai</h3>
      </a>

      <a href="/category/Fantasy" class="browse-category-card">
        <div class="browse-category-icon">🧙</div>
        <h3 class="browse-category-title">Fantasy</h3>
      </a>

      <a href="/category/Comedy" class="browse-category-card">
        <div class="browse-category-icon">😂</div>
        <h3 class="browse-category-title">Comedy</h3>
      </a>

      <a href="/category/Shounen" class="browse-category-card">
        <div class="browse-category-icon">🔥</div>
        <h3 class="browse-category-title">Shounen</h3>
      </a>

      <a href="/list/popular" class="browse-category-card">
        <div class="browse-category-icon">⭐</div>
        <h3 class="browse-category-title">Top Rated</h3>
      </a>

      <a href="/list/new" class="browse-category-card">
        <div class="browse-category-icon">🆕</div>
        <h3 class="browse-category-title">New Releases</h3>
      </a>

      <a href="/category/Adventure" class="browse-category-card">
        <div class="browse-category-icon">🗺️</div>
        <h3 class="browse-category-title">Adventure</h3>
      </a>

      <a href="/category/Drama" class="browse-category-card">
        <div class="browse-category-icon">🎭</div>
        <h3 class="browse-category-title">Drama</h3>
      </a>

      <a href="/category/Sci-Fi" class="browse-category-card">
        <div class="browse-category-icon">🚀</div>
        <h3 class="browse-category-title">Sci-Fi</h3>
      </a>

      <a href="/category/Sports" class="browse-category-card">
        <div class="browse-category-icon">🏆</div>
        <h3 class="browse-category-title">Sports</h3>
      </a>

      <a href="/category/Supernatural" class="browse-category-card">
        <div class="browse-category-icon">👻</div>
        <h3 class="browse-category-title">Supernatural</h3>
      </a>

      <a href="/category/Thriller" class="browse-category-card">
        <div class="browse-category-icon">🔪</div>
        <h3 class="browse-category-title">Thriller</h3>
      </a>

      <a href="/category/Music" class="browse-category-card">
        <div class="browse-category-icon">🎵</div>
        <h3 class="browse-category-title">Music</h3>
      </a>
