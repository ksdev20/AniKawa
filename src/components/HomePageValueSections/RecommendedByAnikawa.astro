---
import AnimeSliderStatic from "../AnimeSlider/AnimeSliderStatic.astro";
const sliderData = Astro.props.info;
---

<section class="editors-section put-margin">
  <div class="section-header">
    <span class="section-badge"> 💜 AniKawa Picks </span>

    <h2 class="section-title">Editor's Picks</h2>

    <p class="section-subtitle">
      Anime we believe every fan should experience.
    </p>
  </div>

  <AnimeSliderStatic info={sliderData} />

  <section class="editors-note-section">
    <div class="editors-note-container">
      <h3 class="editors-note-title">Why We Chose These Anime</h3>

      <div class="editors-reasons">
        <div class="editor-reason">
          <span>✨</span>
          <div>
            <h4>Unforgettable Stories</h4>
            <p>
              Anime with stories that stay with you long after the final
              episode.
            </p>
          </div>
        </div>

        <div class="editor-reason">
          <span>🌌</span>
          <div>
            <h4>Unique Worlds & Ideas</h4>
            <p>
              Series that explore concepts and experiences you won't find
              everywhere.
            </p>
          </div>
        </div>

        <div class="editor-reason">
          <span>💙</span>
          <div>
            <h4>Emotional Impact</h4>
            <p>
              Shows that make you laugh, think, and genuinely connect with the
              story.
            </p>
          </div>
        </div>

        <div class="editor-reason">
          <span>🔥</span>
          <div>
            <h4>Hidden Gems</h4>
            <p>Amazing anime that deserve more attention from fans.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</section>
