---
import "@/styles/components/HomePage/anikawa-picks.css";
import AnimeSliderStatic from "../AnimeSlider/AnimeSliderStatic.astro";
import {
  SparkleIcon,
  ArrowRightIcon,
  LightbulbIcon,
} from "@phosphor-icons/react";

const sliderData = Astro.props.info;
---

<section class="anikawa-picks">
  <div class="anikawa-picks-container">
    <!-- ============================================================
         HEADER
         ============================================================ -->

    <header class="anikawa-picks-header">
      <div class="anikawa-picks-heading">
        <span class="anikawa-picks-kicker">
          <SparkleIcon size={15} weight="duotone" />
          AniKawa Picks
        </span>

        <h2 class="anikawa-picks-title">
          Handpicked anime.
          <span>Worth your time.</span>
        </h2>

        <p class="anikawa-picks-subtitle">
          A selection from the AniKawa team — stories, worlds, and experiences
          we think are worth discovering.
        </p>
      </div>

      <a href="/list?sort=popular" class="anikawa-picks-link">
        Explore anime
        <ArrowRightIcon size={17} weight="bold" aria-hidden="true" />
      </a>
    </header>

    <!-- ============================================================
         ANIME RAIL
         ============================================================ -->

    <div class="anikawa-picks-slider">
      <AnimeSliderStatic info={sliderData} />
    </div>

    <!-- ============================================================
         EDITORIAL NOTE
         ============================================================ -->

    <aside class="anikawa-picks-note">
      <div class="anikawa-picks-note-icon">
        <LightbulbIcon size={20} weight="duotone" />
      </div>

      <div>
        <h3>Why these picks?</h3>

        <p>
          We look beyond popularity. These recommendations can come from
          memorable storytelling, distinctive worlds, emotional impact, or
          simply being an anime we think deserves more attention.
        </p>
      </div>
    </aside>
  </div>
</section>
