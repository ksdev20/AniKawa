---
import { getNewest15Anime } from "../../filters/animeFilterMainTmdbVer.ts";
import AnimeSliderCSR from "../AnimeSlider/AnimeSliderCSR";
import AnimeCardStaticTmdbVer from "../AnimeCard/AnimeCardStaticTmdbVer.astro";
import {
  SparkleIcon,
  ArrowRightIcon,
  CalendarPlusIcon,
} from "@phosphor-icons/react";

const latestAnime = await getNewest15Anime();
---

<section class="popular-anime-section put-margin">
  <div class="popular-anime-container">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <header class="popular-anime-header">
      <div class="popular-anime-heading">

        <span class="popular-anime-kicker">
          <SparkleIcon size={15} weight="duotone" />
          Fresh Additions
        </span>

        <h2 class="popular-anime-title">
          New on
          <span> AniKawa.</span>
        </h2>

        <p class="popular-anime-subtitle">
          Explore the newest anime series, seasons, and additions to the
          AniKawa catalog.
        </p>

      </div>

      <a
        href="/list?sort=newest"
        class="popular-anime-link"
      >
        Explore new
        <ArrowRightIcon size={17} weight="bold" aria-hidden="true" />
      </a>
    </header>

    <!-- ============================================================
         ANIME RAIL
         ============================================================ -->

    <div class="popular-anime-slider">
      <section class="slider-content-wrapper">
        <ul class="slider-container">
          {
            latestAnime.map((anime: any) => (
              <AnimeCardStaticTmdbVer anime={anime} />
            ))
          }
        </ul>

        <AnimeSliderCSR client:load />
      </section>
    </div>

    <!-- ============================================================
         CONTEXT
         ============================================================ -->

    <aside class="popular-anime-context">
      <div class="popular-anime-context-icon">
        <CalendarPlusIcon size={20} weight="duotone" />
      </div>

      <div>
        <h3>Always something new</h3>

        <p>
          This collection makes it easy to discover the latest additions to
          AniKawa without digging through the entire catalog.
        </p>
      </div>
    </aside>

  </div>
</section>