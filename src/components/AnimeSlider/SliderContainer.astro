---
import type { Anime } from "../../types/mergedListTypes";
import AnimeCardStatic from "../AnimeCard/AnimeCardStaticTmdbVer.astro";
import AnimeSliderCSR from "./AnimeSliderCSR";

const animeArray = (Astro.props.animeArray || []) as Anime[];
---

<ul class="slider-container">
    {
        animeArray?.map((a) => {
            return <AnimeCardStatic anime={a} />;
        })
    }
</ul>
<AnimeSliderCSR client:load />
