---
import { getFilteredAnime } from "../../filters/animeFilterMainTmdbVer";
import SliderContainer from "./SliderContainer.astro";
import "./anime-slidertw.css";

const {
    bigH,
    smallH,
    filterName,
    genresA,
    categoryA = "",
    categoryB = "",
    usedTitlesGlobal,
    forAnimePage = false,
} = Astro.props.info;

let filteredAnimeList;

const forCategory = filterName == "matchCategories" && !forAnimePage;

if (filterName == "matchCategories") {
    if (genresA && genresA.length > 0) {
        filteredAnimeList = getFilteredAnime("matchCategories", {
            genresA: genresA,
            usedTitlesGlobal,
        });
    }
    if (categoryA != "" && categoryB != "") {
        filteredAnimeList = getFilteredAnime("matchCategories", {
            categoryA: categoryA,
            categoryB: categoryB,
            usedTitlesGlobal,
        });
    }
} else {
    filteredAnimeList = getFilteredAnime(filterName, { usedTitlesGlobal });
}

if (filteredAnimeList) {
    if (filteredAnimeList.length == 0) {
        return;
    }
}
---

{
    !forCategory ? (
        <section
            class="anime-slider-section">
            <div class="slider-heading">
                <h2 class="slider-section-text-big">{bigH}</h2>
                <h3 class="slider-section-text-small">{smallH}</h3>
            </div>
            <div class="slider-content-wrapper">
                <SliderContainer animeArray={filteredAnimeList} />
            </div>
        </section>
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "ItemList",
            "name": bigH,
            "itemListElement": filteredAnimeList?.map((a, i) => ({
                "@type": "ListItem",
                "position": i + 1,
                "item": {
                    "@type": "TVSeries",
                    "@id": `https://anikawa1-2.onrender.com/show/${a.nanoid}/${a.slug}`,
                    "name": a.title ||  a.slug || 'Untitled'
                }
            }))
        })}></script>
    ) : (
        <section class="anime-slider-section cat-slider">
            <div class="slider-heading cat-slider-heading">
                <h2 class="slider-section-text-big cat-slider-heading-big">
                    {bigH}
                </h2>
                <a
                    class="view-all-text-section"
                    href={`/category/${categoryA}/${bigH}`}
                >
                    VIEW ALL
                    <svg
                        class="view-all-icon"
                        xmlns="http://www.w3.org/2000/svg"
                        height="17px"
                        viewBox="0 -960 960 960"
                        width="17px"
                        fill="#666666"
                    >
                        <path d="m321-80-71-71 329-329-329-329 71-71 400 400L321-80Z" />
                    </svg>
                </a>
            </div>
            <div class="slider-content-wrapper">
                <SliderContainer animeArray={filteredAnimeList} />
            </div>
        </section>
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "ItemList",
            "name": bigH,
            "itemListElement": filteredAnimeList?.map((a, i) => ({
                "@type": "ListItem",
                "position": i + 1,
                "item": {
                    "@type": "TVSeries",
                    "@id": `https://anikawa1-2.onrender.com/show/${a.nanoid}/${a.slug}`,
                    "name": a.title || a.slug || 'Untitled'
                }
            }))
        })}></script>
    )
}
