---
import { getOtherSeasons } from "../../filters/anime-page-filters";
import { getFilteredAnime } from "../../filters/animeFilterMainTmdbVer.ts";
import AnimeSliderCSR from "./AnimeSliderCSR";
import AnimeCardStaticTmdbVer from "../AnimeCard/AnimeCardStaticTmdbVer.astro";
import "./anime-slidertw.css";
import { frontendUrl } from "@/global_assets/globalPaths";

const {
  bigH,
  smallH,
  filterName,
  genresA,
  categoryA = "",
  categoryB = "",
  usedTitlesGlobal,
  forCategoryPage = false,
  forAnimePageSeasons,
  animeTitle,
  toNotInclude,
} = Astro.props.info;

let filteredAnimeList;

if (forCategoryPage) {
  filteredAnimeList = await getFilteredAnime("matchCategories", {
    categoryA: categoryA,
    categoryB: categoryB,
    usedTitlesGlobal,
  });
} else if (forAnimePageSeasons) {
  filteredAnimeList = await getOtherSeasons(animeTitle, toNotInclude);
} else if (filterName == "matchCategories") {
  filteredAnimeList = await getFilteredAnime("matchCategories", {
    genresA: genresA,
    usedTitlesGlobal,
  });
} else if (
  filterName === "recommendedByAnikawa" ||
  filterName === "topRatedLast5"
) {
  filteredAnimeList = await getFilteredAnime(filterName, {
    usedTitlesGlobal: [],
  });
} else {
  filteredAnimeList = await getFilteredAnime(filterName, {
    usedTitlesGlobal: [],
  });
}

if (filteredAnimeList) {
  if (filteredAnimeList.length <= 1) {
    return null;
  }
}
if (!filteredAnimeList) return null;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: bigH,
  itemListElement: filteredAnimeList?.map((a, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "TVSeries",
      "@id": `${frontendUrl}/show/${a.nanoid}/${a.slug}`,
      name: a.title || a.slug || "Untitled",
    },
  })),
};
---

<section class="anime-slider-section">
  <header class="slider-heading">
    <h2 class="slider-section-text-big">{bigH}</h2>
    <h3 class="slider-section-text-small">{smallH}</h3>
  </header>
  <section class="slider-content-wrapper">
    <ul class="slider-container">
      {
        filteredAnimeList?.map((a) => {
          return (
            <AnimeCardStaticTmdbVer anime={a} forCategory={forCategoryPage} />
          );
        })
      }
    </ul>
    <AnimeSliderCSR client:load />
  </section>
</section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
