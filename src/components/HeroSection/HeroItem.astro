---
import { getAnimeById } from "../../filters/getAnimeById";
import { Icon } from "../../icons/icons";
import AnimeWBtn from "../AnimeCard/AnimeWBtn";

const { nId, i } = Astro.props;
const anime = getAnimeById(nId);
const isFirst = i == 0;
const {
  nanoid = "n-a",
  slug,
  title = "untitled",
  description,
  poster,
  backdrop,
  scoreAlt,
  logos_en,
} = anime ?? {};

const ep1Slug = anime?.episodes?.[0]?.slug ?? "n-a";

const imgPrefix = "https://image.tmdb.org/t/p/original";
const getImg = (suffix: string | undefined) => {
  return imgPrefix + suffix;
};

const validLogo = logos_en ? (logos_en[0] ?? logos_en[1] ?? logos_en[2]) : "";
const logoUrl = getImg(validLogo);

let extraBd = null;
switch (nId) {
  case "3eZ7GbrMIriv2ap":
    extraBd = getImg(anime?.extra_backdrops[1]);
    break;
  case "EeRKboXUJK4bsgb":
    extraBd = getImg(anime?.extra_backdrops[2]);
    break;
  default:
    extraBd = null;
    break;
}

const language = "Subtitled";

const imgL = i == 0 ? "eager" : "lazy";
const imgD = "async";
---

<li class="hero-section-root">
  <article>
    <div class="hs-img-section">
      <a
        href={`/show/${nanoid}/${slug}`}
        class="hs-anime-img outline-0 group"
        tabindex={isFirst ? 0 : -1}
      >
        <div class="sr-only">Go to Anime {title} Page</div>
        <img
          class="hs-anime-img"
          src={poster}
          alt={`Cover of ${title}`}
          loading={imgL}
          decoding={imgD}
          fetchpriority="high"
        />
      </a>
      <div class="hero-section-overlay">
        <h2 class="hs-title">{title}</h2>
        <a
          href={`/show/${nanoid}/${slug}`}
          class="w-fit outline-0 group"
          tabindex={isFirst ? 0 : -1}
        >
          <div class="sr-only">Go to Anime {title} Page</div>
          <img
            class="hs-title-img"
            src={logoUrl}
            alt={`Logo image for
                      ${title}`}
            loading={imgL}
            decoding={imgD}
            fetchpriority="high"
          />
        </a>
        <span class="dub-sub">{language} ➤ {scoreAlt}</span>
        <p class="hero-description">{description}</p>
        <div class="hero-button-section">
          <a
            class="start-watching-btn hero-play"
            href={`/episode/${nanoid}/${ep1Slug}`}
            aria-label={`Start
                        watching ${title}, episode 1`}
            tabindex={isFirst ? 0 : -1}
          >
            <Icon name="play" size={28} color="#000000" />
            START WATCHING S1 E1
          </a>
          <div class="watchlist-btn" tabindex={isFirst ? 0 : -1}>
            <AnimeWBtn
              nanoid={nanoid}
              client:load
              tabIndex={isFirst ? 0 : -1}
            />
          </div>
        </div>
      </div>
    </div>
  </article>
  <img
    class="hs-anime-banner"
    src={extraBd ?? backdrop}
    alt={`Backdrop of
        ${title}`}
    loading={imgL}
    decoding={imgD}
    fetchpriority="high"
  />
  <div class="hero-gradient-left"></div>
</li>
