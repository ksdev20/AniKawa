---
import { getAnimeById } from "../../filters/getAnimeById";
import { getPosterType } from "../../utils/imageSizing";

const { nId, i } = Astro.props;
const anime = await getAnimeById(nId);
const isFirst = i == 0;
const {
  nanoid = "n-a",
  slug,
  title = "untitled",
  poster = "/anime-image-alt.png",
  backdrop = "/episode-thumbnail-alt-2.png",
  logos_en,
  score,
  ratedBy,
  genres,
  episodes,
  number_of_episodes,
  runtime,
  status,
  anikawaReview,
  badge,
} = anime ?? {};

const ep1Nanoid = episodes?.[0]?.nanoid;
const ep1Slug = episodes?.[0]?.slug ?? "n-a";
const totalEp = episodes?.length ?? 0;

const imgPrefix = "https://image.tmdb.org/t/p/original";
const getImg = (suffix: string | undefined) => {
  return imgPrefix + suffix;
};

const validLogo = logos_en ? (logos_en[0] ?? logos_en[1] ?? logos_en[2]) : "";
const logoUrl = getImg(validLogo);

let extraBd = null;
switch (nId) {
  case "3eZ7GbrMIriv2ap":
    extraBd = getImg(anime?.extra_backdrops[1]);
    break;
  case "EeRKboXUJK4bsgb":
    extraBd = getImg(anime?.extra_backdrops[2]);
    break;
  default:
    extraBd = null;
    break;
}

const getBackdropType = (backdrop: string | null, backdropType: string) =>
  backdrop?.slice(0).replace("original", backdropType);

const verdict = anikawaReview?.verdict;
const whyWatch = anikawaReview?.strengths.slice(0, 3);

const imgL = i == 0 ? "eager" : "lazy";
const imgD = "async";
const fetchP = i == 0 ? "high" : null;
const starCount = Math.round(Number(score) / 2);

const star = "★";
---

<li class="hero-section-root">
  <article>
    <div class="hs-img-section">
      <a
        href={`/show/${nanoid}/${slug}`}
        class="hs-anime-img outline-0 group"
        tabindex={isFirst ? 0 : -1}
      >
        <div class="anime-badge">
          {badge}
        </div>
        <div class="sr-only">Go to Anime {title} Page</div>
        <img
          class="hs-anime-img mobile"
          src={getPosterType(poster, "w342")}
          height="300"
          width="200"
          alt={`Cover of ${title}`}
          loading={imgL}
          decoding={imgD}
          fetchpriority={fetchP}
        />
        <img
          class="hs-anime-img pc"
          src={getPosterType(poster, "w342")}
          width="200"
          height="300"
          srcset={`
    ${getPosterType(poster, "w500")} 500w,
    ${getPosterType(poster, "w780")} 780w
  `}
          sizes="
    (max-width: 600px) 100vw,
    185px
  "
          alt={`Cover of ${title}`}
          loading={imgL}
          decoding={imgD}
          fetchpriority={fetchP}
        />
      </a>
      <div class="hero-section-overlay">
        <!-- <h2 class="hs-title">{title}</h2> -->
        <a
          href={`/show/${nanoid}/${slug}`}
          class="title-wrapper-hs group"
          tabindex={isFirst ? 0 : -1}
        >
          <div class="sr-only">Go to Anime {title} Page</div>
          <img
            class="hs-title-img"
            src={logoUrl}
            alt={`Logo image for
                      ${title}`}
            loading={imgL}
            decoding={imgD}
            fetchpriority="high"
          />
        </a>
        <div class="anime-meta-widget">
          <!-- Rating -->
          <div class="review-widget">
            <div class="stars">
              <span>{star}</span>
            </div>

            <span class="rating-score">
              {Math.floor(starCount as number)} • {ratedBy} Ratings
            </span>
          </div>

          <!-- Genres -->
          <div class="genre-widget">
            {
              genres?.slice(0, 2)?.map((genre) => (
                <a class="genre-pill" href={`/category/${genre}`}>
                  {genre}
                </a>
              ))
            }
          </div>

          <!-- Details -->
          <div class="anime-details">
            <span>{number_of_episodes ?? totalEp} Episodes</span>
            <span class="separator">•</span>
            <span>{runtime}</span>
            <span class="separator">•</span>
            <span>{status}</span>
          </div>
        </div>
        <div class="verdict-widget">
          <div class="verdict-header">
            <span class="verdict-icon">⭐</span>
            <span class="verdict-title">Verdict</span>
          </div>

          <p class="verdict-text">
            {verdict}
          </p>
        </div>
        <section class="why-watch">
          <h2 class="why-watch-title">Why Watch?</h2>

          <ul class="why-watch-list">
            {
              whyWatch?.map((reason) => (
                <li class="why-watch-item">
                  <span class="why-watch-icon">✓</span>
                  <span>{reason}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- <p class="hero-description">{description}</p> -->
        <div class="hero-button-section">
          <!-- <div class="watchlist-btn" tabindex={isFirst ? 0 : -1}>
            <AnimeWBtn
              client:idle
            />
          </div> -->
          <div class="wrapper">
            <a class="cta" href={`/episode/${nanoid}/${ep1Nanoid}/${ep1Slug}`}>
              <span>Watch Episode 1</span>
              <span>
                <svg
                  width="24px"
                  height="24px"
                  viewBox="0 0 66 43"
                  version="1.1"
                  xmlns="http://www.w3.org/2000/svg"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                >
                  <g
                    id="arrow"
                    stroke="none"
                    stroke-width="1"
                    fill="none"
                    fill-rule="evenodd"
                  >
                    <path
                      class="one"
                      d="M40.1543933,3.89485454 L43.9763149,0.139296592 C44.1708311,-0.0518420739 44.4826329,-0.0518571125 44.6771675,0.139262789 L65.6916134,20.7848311 C66.0855801,21.1718824 66.0911863,21.8050225 65.704135,22.1989893 C65.7000188,22.2031791 65.6958657,22.2073326 65.6916762,22.2114492 L44.677098,42.8607841 C44.4825957,43.0519059 44.1708242,43.0519358 43.9762853,42.8608513 L40.1545186,39.1069479 C39.9575152,38.9134427 39.9546793,38.5968729 40.1481845,38.3998695 C40.1502893,38.3977268 40.1524132,38.395603 40.1545562,38.3934985 L56.9937789,21.8567812 C57.1908028,21.6632968 57.193672,21.3467273 57.0001876,21.1497035 C56.9980647,21.1475418 56.9959223,21.1453995 56.9937605,21.1432767 L40.1545208,4.60825197 C39.9574869,4.41477773 39.9546013,4.09820839 40.1480756,3.90117456 C40.1501626,3.89904911 40.1522686,3.89694235 40.1543933,3.89485454 Z"
                      fill="#FFFFFF"></path>
                    <path
                      class="two"
                      d="M20.1543933,3.89485454 L23.9763149,0.139296592 C24.1708311,-0.0518420739 24.4826329,-0.0518571125 24.6771675,0.139262789 L45.6916134,20.7848311 C46.0855801,21.1718824 46.0911863,21.8050225 45.704135,22.1989893 C45.7000188,22.2031791 45.6958657,22.2073326 45.6916762,22.2114492 L24.677098,42.8607841 C24.4825957,43.0519059 24.1708242,43.0519358 23.9762853,42.8608513 L20.1545186,39.1069479 C19.9575152,38.9134427 19.9546793,38.5968729 20.1481845,38.3998695 C20.1502893,38.3977268 20.1524132,38.395603 20.1545562,38.3934985 L36.9937789,21.8567812 C37.1908028,21.6632968 37.193672,21.3467273 37.0001876,21.1497035 C36.9980647,21.1475418 36.9959223,21.1453995 36.9937605,21.1432767 L20.1545208,4.60825197 C19.9574869,4.41477773 19.9546013,4.09820839 20.1480756,3.90117456 C20.1501626,3.89904911 20.1522686,3.89694235 20.1543933,3.89485454 Z"
                      fill="#FFFFFF"></path>
                    <path
                      class="three"
                      d="M0.154393339,3.89485454 L3.97631488,0.139296592 C4.17083111,-0.0518420739 4.48263286,-0.0518571125 4.67716753,0.139262789 L25.6916134,20.7848311 C26.0855801,21.1718824 26.0911863,21.8050225 25.704135,22.1989893 C25.7000188,22.2031791 25.6958657,22.2073326 25.6916762,22.2114492 L4.67709797,42.8607841 C4.48259567,43.0519059 4.17082418,43.0519358 3.97628526,42.8608513 L0.154518591,39.1069479 C-0.0424848215,38.9134427 -0.0453206733,38.5968729 0.148184538,38.3998695 C0.150289256,38.3977268 0.152413239,38.395603 0.154556228,38.3934985 L16.9937789,21.8567812 C17.1908028,21.6632968 17.193672,21.3467273 17.0001876,21.1497035 C16.9980647,21.1475418 16.9959223,21.1453995 16.9937605,21.1432767 L0.15452076,4.60825197 C-0.0425130651,4.41477773 -0.0453986756,4.09820839 0.148075568,3.90117456 C0.150162624,3.89904911 0.152268631,3.89694235 0.154393339,3.89485454 Z"
                      fill="#FFFFFF"></path>
                  </g>
                </svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
  <picture class="hs-anime-banner">
    <source
      media="(max-width: 300px)"
      srcset={getBackdropType(backdrop, "w300")}
    />
    <source
      media="(max-width: 780px)"
      srcset={getBackdropType(backdrop, "w780")}
    />
    <source
      media="(max-width: 1281px)"
      srcset={getBackdropType(backdrop, "w1280")}
    />

    <img
      class="hs-anime-banner"
      width="1280"
      height="720"
      src={extraBd ?? backdrop}
      alt={`Backdrop of
        ${title}`}
      loading={imgL}
      decoding={imgD}
      fetchpriority={fetchP}
    />
  </picture>

  <div class="hero-gradient-left"></div>
</li>
