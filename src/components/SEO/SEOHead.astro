---
import { frontendUrl } from "../../global_assets/globalPaths";
import { metadata } from "../../utils/head-seo";

interface SeoHeadProps {
  name?: string;
  title: string;
  description: string;
  keywords: string;
  ogDescription: string;
  url: string;
  imageUrl: string;
  author: string;
  jsonLd: any;
}

const {
  name = metadata.name,
  title = metadata.title,
  description = metadata.description,
  keywords = metadata.keywords,
  ogDescription = metadata.openGraph.description,
  url = metadata.metadataBase,
  imageUrl = metadata.openGraph.images[0].url,
  author = metadata.author.name,
  jsonLd = metadata.jsonLd,
} = Astro.props as SeoHeadProps;

const isHomepage = Astro.url.pathname == "/";
---

<head>
  <title>{title}</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content={author} />
  <meta
    name="robots"
    content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  />

  <meta name="og:type" content="website" />
  <meta name="og:url" content={url} />
  <meta name="og:title" content={title} />
  <meta name="og:description" content={ogDescription} />
  <meta name="og:site_name" content={name} />
  <meta name="og:image" content={imageUrl} />
  <meta name="og:image:width" content="1200" />
  <meta name="og:image:height" content="630" />
  <meta name="og:image:alt" content="AniKawa - Watch Anime Free in HD" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={"@" + name.toLowerCase()} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:creator" content={author} />

  <link rel="canonical" href={url} />
  <link
    rel="sitemap"
    type="application/xml"
    title="AniKawa Sitemap"
    href={frontendUrl + "/sitemap.xml"}
  />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link
    rel="icon"
    type="image/png"
    sizes="192x192"
    href="/android-chrome-192x192.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="512x512"
    href="/android-chrome-512x512.png"
  />
  <link rel="manifest" href="/site.webmanifest" />

  {
    isHomepage && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )
  }
  <link
    rel="preload"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500..600&family=Poetsen+One&family=Winky+Sans&display=swap"
    as="style"
    onload="this.onLoad=null;this.rel='stylesheet'"
  />
  <link rel="preconnect" href="https://image.tmdb.org" crossorigin />
  <link rel="dns-prefetch" href="//image.tmdb.org" />
  <slot />
  <script
    is:inline
    async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4788349295521290"
    crossorigin="anonymous"></script>
  <!-- MICROSOFT CLARITY SETUP -->
  <script is:inline type="text/javascript">
    (function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          (c[a].q = c[a].q || []).push(arguments);
        };
      t = l.createElement(r);
      t.async = 1;
      t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", "xob25q7l1q");
  </script>

  /*OneSignal Notifications Setup*/
  <script
    is:inline
    src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js"
    defer></script>

  <script is:inline>
    window.OneSignalDeferred = window.OneSignalDeferred || [];

    window.OneSignalDeferred.push(async function (OneSignal) {
      await OneSignal.init({
        appId: "d3aae22b-4a19-4d45-a1f6-fffe3abbb02c",
      });
    });
  </script>
</head>
