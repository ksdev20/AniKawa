---
import { metadata } from "../../utils/head-seo";

interface SeoHeadProps {
  title: string;
  description: string;
  keywords: string;
  ogDescription: string;
  url: string;
  imageUrl: string;
  author: string;
  jsonLd: any;
}

const {
  title = metadata.title,
  description = metadata.description,
  keywords = metadata.keywords,
  ogDescription = metadata.openGraph.description,
  url = metadata.metadataBase,
  imageUrl = metadata.openGraph.images[0].url,
  author = metadata.author.name,
  jsonLd = metadata.jsonLd,
} = Astro.props as SeoHeadProps;

const isHomepage = Astro.url.pathname == "/";
---

<head>
  <meta name="google-site-verification" content="5MRqdcSrbtfXyuRJn8dzV0xm1QVir85-wQ_h4P7I7l0" />
  <title>{title}</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content={author} />
  <meta
    name="robots"
    content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  />

  <meta name="og:type" content="website" />
  <meta name="og:url" content={url} />
  <meta name="og:title" content={title} />
  <meta name="og:description" content={ogDescription} />
  <meta name="og:site_name" content="Anikawa" />
  <meta
    name="og:image"
    content="https://anikawa.vercel.app/anikawa-og-img-pc.webp"
  />
  <meta name="og:image:width" content="1200" />
  <meta name="og:image:height" content="630" />
  <meta name="og:image:alt" content="AniKawa - Watch Anime Free in HD" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@anikawa" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:creator" content="Anikawa Team" />

  <link rel="canonical" href={url} />
  <link
    rel="sitemap"
    type="application/xml"
    title="AniKawa Sitemap"
    href="https://anikawa.vercel.app/sitemap.xml"
  />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link
    rel="icon"
    type="image/png"
    sizes="192x192"
    href="/android-chrome-192x192"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="512x512"
    href="/android-chrome-512x512"
  />
  <link rel="manifest" href="/site.webmanifest" />

  {
    isHomepage && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )
  }
  <link
    rel="preload"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500..600&family=Poetsen+One&family=Winky+Sans&display=swap"
    as="style"
    onload="this.onLoad=null;this.rel='stylesheet'"
  />
  <slot />
</head>
