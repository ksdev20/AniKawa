---
import { frontendUrl } from "../../global_assets/globalPaths";
import { metadata } from "../../utils/head-seo";

interface SeoHeadProps {
  name?: string;
  title: string;
  description: string;
  keywords: string;
  ogDescription: string;
  url: string;
  imageUrl: string;
  author: string;
  jsonLd: any;
}

const {
  name = metadata.name,
  title = metadata.title,
  description = metadata.description,
  keywords = metadata.keywords,
  ogDescription = metadata.openGraph.description,
  url = metadata.metadataBase,
  imageUrl = metadata.openGraph.images[0].url,
  author = metadata.author.name,
  jsonLd = metadata.jsonLd,
} = Astro.props as SeoHeadProps;

const isHomepage = Astro.url.pathname == "/";
const isNotEpisodePage = !Astro.url.pathname.includes("episode");
---

<head>
  <meta
    name="9edf5169b4ac32b18cf39bb9d2817d21991fcdf6"
    content="9edf5169b4ac32b18cf39bb9d2817d21991fcdf6"
  />

  <!-- Hilltopads Popunder -->
  {isNotEpisodePage && <script>
(function(taqz){
var d = document,
    s = d.createElement('script'),
    l = d.scripts[d.scripts.length - 1];
s.settings = taqz || {};
s.src = "\/\/nautical-hand.com\/cGD\/9n6.b\/2V5UlmSCW\/Qo9BN\/zbEA3sMlj-cWxOMryB0Z3YMdT\/c\/yMNSzAEo3j";
s.async = true;
s.referrerPolicy = 'no-referrer-when-downgrade';
l.parentNode.insertBefore(s, l);
})({})
</script>}

  <!-- Banner Homepage 1 -->

  {isNotEpisodePage && <script>
    (function (azifv) {
      var d = document,
        s = d.createElement("script"),
        l = d.getElementById("banner-ad-1");
      s.settings = azifv || {};
      s.src =
        "\/\/deliciouslip.com\/baXjV.sndHGQln0_YTW\/cY\/eeBmJ9SubZGUGlxkbPuTxc\/xvNNzKItzJMnDQUPtUNiz\/Eh3\/MejBMXw\/OrQS";
      s.async = true;
      s.referrerPolicy = "no-referrer-when-downgrade";
      l.parentNode.insertBefore(s, l);
    })({});
  </script>}

  <!-- Banner Homepage 3 -->
  {isNotEpisodePage && <script>
    (function (phoh) {
      var d = document,
        s = d.createElement("script"),
        l = d.getElementById("banner-ad-2") ?? d.scripts[d.scripts.length - 1];

      s.settings = phoh || {};
      s.src =
        "\/\/deliciouslip.com\/biX.V_sidwGflJ0uYvWCcO\/teIm\/9IuRZcUhl\/kjP_TNc\/xPNszdIcz\/NxTVcTtvNEz\/Es3\/Msj_Mo2\/MCQh";
      s.async = true;
      s.referrerPolicy = "no-referrer-when-downgrade";
      l.parentNode.insertBefore(s, l);
    })({});
  </script>}

  <!-- Banner Homepage 2 -->
  {isNotEpisodePage && <script>
    (function (phoh) {
      var d = document,
        s = d.createElement("script"),
        l = d.getElementById("banner-ad-3") ?? d.scripts[d.scripts.length - 1];
      s.settings = phoh || {};
      s.src =
        "\/\/deliciouslip.com\/b.X_VQsrdIGslc0VYxWjcg\/ae\/m\/9buUZfUglKk\/PgTkcxxwNWznIYzGMaj\/EStvNOzbEn3BM\/jfMcyRNEQy";
      s.async = true;
      s.referrerPolicy = "no-referrer-when-downgrade";
      l.insertBefore(s, l);
    })({});
  </script>}
  <!-- Hilltop In-page push Ads -->
  {isNotEpisodePage && <script>
    (function (azifv) {
      var d = document,
        s = d.createElement("script"),
        l = d.scripts[d.scripts.length - 1] ?? d.scripts[d.scripts.length - 1];
      s.settings = azifv || {};
      s.src =
        "\/\/deliciouslip.com\/b-X\/VlsWd.GmlN0UY\/WLck\/Xe\/mE9\/uXZBUwlTkxPrTccWxqN_z\/I\/zoNuzjMat\/NNz\/Eo3FMSjlMe3\/Nvwa";
      s.async = true;
      s.referrerPolicy = "no-referrer-when-downgrade";
      l.parentNode.insertBefore(s, l);
    })({});
  </script>}

  <!-- Hilltop Video Slider -->
  {isNotEpisodePage && <script>
    (function (azifv) {
      var d = document,
        s = d.createElement("script"),
        l = d.scripts[d.scripts.length - 1];
      s.settings = azifv || {};
      s.src =
        "\/\/deliciouslip.com\/bEXqVSstd.GWlT0\/YsWqcS\/we\/m\/9ZuaZMUMldkjPvTwczxCNnzQIPzBOETRcCtNNMzdEg3eM_jrQSw\/MPQL";
      s.async = true;
      s.referrerPolicy = "no-referrer-when-downgrade";
      l.parentNode.insertBefore(s, l);
    })({});
  </script>}

  <title>{title}</title>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
  />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content={author} />
  <meta
    name="robots"
    content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  />

  <meta name="og:type" content="website" />
  <meta name="og:url" content={url} />
  <meta name="og:title" content={title} />
  <meta name="og:description" content={ogDescription} />
  <meta name="og:site_name" content={name} />
  <meta name="og:image" content={imageUrl} />
  <meta name="og:image:width" content="1200" />
  <meta name="og:image:height" content="630" />
  <meta name="og:image:alt" content="AniKawa - Watch Anime Free in HD" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={"@" + name.toLowerCase()} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:creator" content={author} />

  <link rel="canonical" href={url} />
  <link
    rel="sitemap"
    type="application/xml"
    title="AniKawa Sitemap"
    href={frontendUrl + "/sitemap.xml"}
  />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link
    rel="icon"
    type="image/png"
    sizes="192x192"
    href="/android-chrome-192x192"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="512x512"
    href="/android-chrome-512x512"
  />
  <link rel="manifest" href="/site.webmanifest" />

  {
    isHomepage && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )
  }
  <link
    rel="preload"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500..600&family=Poetsen+One&family=Winky+Sans&display=swap"
    as="style"
    onload="this.onLoad=null;this.rel='stylesheet'"
  />
  <link rel="preconnect" href="https://image.tmdb.org" crossorigin />
  <link rel="dns-prefetch" href="//image.tmdb.org" />
  <slot />
  <script
    async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4788349295521290"
    crossorigin="anonymous"></script>
</head>
