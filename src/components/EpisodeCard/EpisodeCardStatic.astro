---
import './episode-cardtw.css';
import EDelBtn from './EcDatabaseContact/EDelBtn';
import { Icon } from '../../icons/icons';
const epData = Astro.props.epData as any;
const forHistory = Astro.props.forHistory as boolean ?? false;

if (!epData) return null;

const {
    animeTitle = "Anime Title N/A",
    language = "Language N/A",
    animenanoid,
    slug,
    epNum,
} = epData ?? {};

const {
    titleAlt = `Episode ${epNum}`,
    img = epData?.ytThumbnail ?? "/episode-thumbnail-alt-2.png",
    description = "No description",
} = epData ?? {};
---

<li class="episode-card">
    <article class="episode-card-first">
        <img class="episode-card-image" src={img} loading="lazy" decoding="async" alt={`Cover of ${titleAlt}`}/>
        <h3 class="anime-title">{animeTitle}</h3>
        <h2 class="episode-number-name">{titleAlt}</h2>
        <p class="language-section">{language}</p>

        <div class="episode-card-hover">
            <div class="anime-title">{animeTitle}</div>
            <div class="episode-number-name">{titleAlt}</div>
            <p
                class="episode-number-name episode-description"
                set:html={description}
            >
            </p>
            <div class="episode-play-btn">
                <Icon name='play' size={10} color='#8c52ff' />
                PLAY
            </div>
        </div>
        <a href={`/episode/${animenanoid}/${slug}`} class="episode-card-link"> <div class="sr-only">Go to {titleAlt} of {animeTitle}</div></a>
    </article>
    {forHistory && (
        <EDelBtn animenanoid={animenanoid} slug={slug} client:load />
    )}
</li>
