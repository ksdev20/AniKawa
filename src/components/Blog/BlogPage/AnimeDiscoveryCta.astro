---
import '@/styles/components/Blog/discovery-cta.css';
---
    <div class="anime-discovery-cta-container">
      <div class="anime-discovery-cta-card">
        <div class="anime-discovery-cta-badge">🎌 AniKawa Discovery Hub</div>

        <h2 class="anime-discovery-cta-title">
          Can't Decide What To Watch Next?
        </h2>

        <p class="anime-discovery-cta-description">
          Explore thousands of anime, curated recommendations, community
          ratings, detailed anime guides, hidden gems, seasonal favorites, and
          handpicked collections designed to help you find your next obsession.
        </p>

        <div class="anime-discovery-cta-features">
          <span>⭐ Curated Recommendations</span>

          <span>📚 Detailed Anime Guides</span>

          <span>💜 AniKawa Notes</span>

          <span>🔥 Trending Anime</span>

          <span>🎯 Personalized Discovery</span>

          <span>👥 Community Ratings</span>
        </div>

        <div class="anime-discovery-cta-actions">
          <a href="/" class="anime-discovery-primary-btn"> Browse Anime </a>

          <a href="/categories" class="anime-discovery-secondary-btn">
            Explore Categories
          </a>
        </div>
      </div>
    </div>
  </section>