---
import type { BcObject } from "../../types/blogcard";
import './blogs-section-homepage.css';
const { heading, subheading, btnText, btnLink, posts } = Astro.props.info;
---

<section class="latest-articles-section">
  <div class="latest-articles-container">
    <div class="latest-articles-header">
      <div>
        <span class="section-badge"> ✍️ From the AniKawa Blog </span>

        <h2 class="section-title">
          {heading}
        </h2>

        <p class="section-subtitle">
          {subheading}
        </p>
      </div>

      <a href={btnLink} class="latest-articles-view-all">
        {btnText} →
      </a>
    </div>

    <div class="latest-articles-grid">
      <!-- Featured Article -->

      <a href={`/blog/${posts[0].data.slug}`} class="latest-articles-featured">
        <img
          src={posts[0].data.imgLarge || posts[0].data.img}
          alt={posts[0].data.title}
          loading="lazy"
        />

        <div class="latest-articles-featured-content">
          <div class="latest-articles-categories">
            {
              posts[0].data.categoryList
                .slice(0, 2)
                .map((cat: string) => <span>{cat}</span>)
            }
          </div>

          <h3>
            {posts[0].data.title}
          </h3>

          <p>
            {posts[0].data.subTitle}
          </p>

          <div class="latest-articles-meta">
            <span>{posts[0].data.date}</span>
            <span>•</span>
            <span>{posts[0].data.readMinutes} min read</span>
          </div>
        </div>
      </a>

      <!-- Sidebar Articles -->

      <div class="latest-articles-list">
        {
          posts.slice(1, 4).map((post: BcObject) => (
            <a href={`/blog/${post.data.slug}`} class="latest-articles-card">
              <img src={post.data.img} alt={post.data.title} loading="lazy" />

              <div class="latest-articles-card-content">
                <div class="latest-articles-card-category">
                  {post.data.categoryList[0]}
                </div>

                <h3>{post.data.title}</h3>

                <p>{post.data.subTitle}</p>

                <span class="latest-articles-card-meta">
                  {post.data.readMinutes} min read
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
