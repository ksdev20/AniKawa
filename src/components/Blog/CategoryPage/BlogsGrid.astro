---
import type { BcObject } from "../../../types/blogcard";
import "@/styles/components/Blog/blogs-grid.css";

const { categoryInfo, posts } = Astro.props;

if (!categoryInfo || !posts) {
  throw new Error("Missing props");
}
---

<section class="category-articles-section">
  <div class="category-articles-container">
    <div class="category-articles-header">
      <div class="category-articles-heading">
        <span class="section-badge"> 📚 Articles </span>

        <h2 class="section-title">
          Explore {categoryInfo.title}
        </h2>

        <p class="section-subtitle">
          Browse all articles in this category, from recommendations and watch
          guides to deeper anime discussions.
        </p>
      </div>

      <div class="category-articles-controls">
        <span class="category-articles-count">
          {posts.length} Articles
        </span>

        <span class="category-sort-indicator"> ✨ Sorted by Latest </span>
      </div>
    </div>

    <div class="category-articles-grid">
      {
        posts.length === 0 && (
          <div class="empty-category-state">
            <div class="empty-category-icon">🌱</div>

            <h3 class="empty-category-title">More Articles Are Coming Soon</h3>

            <p class="empty-category-description">
              We're currently working on new {categoryInfo.title.toLowerCase()}{" "}
              articles. Check back soon for recommendations, guides, and anime
              discoveries curated by AniKawa.
            </p>

            <a href="/blog" class="empty-category-btn">
              Browse All Articles
            </a>
          </div>
        )
      }
      {
        posts.map((post: BcObject) => (
          <a href={`/blog/${post.data.slug}`} class="category-article-card">
            <div class="category-article-image-wrapper">
              <img
                src={post.data.img}
                alt={post.data.title}
                class="category-article-image"
                loading="lazy"
              />
            </div>

            <div class="category-article-content">
              <div class="category-article-tags">
                {post.data.categoryList.slice(0, 2).map((cat) => (
                  <span>{cat}</span>
                ))}
              </div>

              <h3 class="category-article-title">{post.data.title}</h3>

              <p class="category-article-subtitle">{post.data.subTitle}</p>

              <div class="category-article-meta">
                <span>📅 {post.data.date}</span>

                {post.data.readMinutes && (
                  <span>⏱️ {post.data.readMinutes} min read</span>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
