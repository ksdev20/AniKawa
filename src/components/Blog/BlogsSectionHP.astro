---
import { Icon } from "../../icons/icons";
import "../../styles/category/category.css";
import AnimeSliderCSR from "../AnimeSlider/AnimeSliderCSR";
import BlogCard from "./BlogCard/BlogCard";
import type { BcObject } from "../../types/blogcard";
const { heading, subheading, btnText, btnLink, posts } = Astro.props.info;
import "../../styles/components/BlogCard/blog-section-hp.css";
---

<section class="anime-slider-section blogs-section-hp">
  <header>
    <div class="part-1">
      <h2 class="slider-section-text-big">{heading}</h2>
      <h3 class="slider-section-text-small blog-sec-subtitle">{subheading}</h3>
    </div>
    <a class="button-sec" href={btnLink}>
      {btnText}
      <Icon name="keyright" color="#ffffff" size={18} />
    </a>
  </header>
  <section class="slider-content-wrapper">
    <ul class="slider-container blogs-slider-container">
      {
        posts.map((post: BcObject) => {
          return <BlogCard BcObject={post} />;
        })
      }
    </ul>
    <AnimeSliderCSR client:load />
  </section>
</section>
