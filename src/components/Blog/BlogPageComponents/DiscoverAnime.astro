---
import "./discover-anime.css";
---

<section class="discover-anime-section">
  <div class="discover-anime-container">
    <div class="discover-anime-header">
      <span class="section-badge"> 🎯 Find Your Next Anime </span>

      <h2 class="section-title">What Are You In The Mood For?</h2>

      <p class="section-subtitle">
        Not sure what to watch next? Explore recommendations based on moods,
        experiences, and the kind of stories you're looking for.
      </p>
    </div>

    <div class="discover-anime-grid">
      <a href="/blog/10-emotional-anime-that-will-make-you-cry" class="discover-anime-card">
        <div class="discover-anime-icon">😭</div>
        <h3>Make Me Cry</h3>
        <p>
          Emotional stories, unforgettable characters, and moments that hit
          right in the heart.
        </p>
      </a>

      <a href="/blog/10-anime-that-will-blow-your-mind" class="discover-anime-card">
        <div class="discover-anime-icon">🧠</div>
        <h3>Blow My Mind</h3>
        <p>
          Twists, mysteries, psychological thrillers, and anime you'll think
          about for days.
        </p>
      </a>

      <a href="/blog/hidden-gem-anime-that-deserve-more-attention" class="discover-anime-card">
        <div class="discover-anime-icon">💎</div>
        <h3>Show Me Hidden Gems</h3>
        <p>Underrated anime that deserve way more love than they get.</p>
      </a>

      <a href="/blog/10-action-anime-that-deliver-from-start-to-finish" class="discover-anime-card">
        <div class="discover-anime-icon">🔥</div>
        <h3>Give Me Action</h3>
        <p>
          Epic battles, powerful rivals, and nonstop excitement from start to
          finish.
        </p>
      </a>

      <a href="/blog/10-relaxing-anime-to-watch-when-you-need-a-break" class="discover-anime-card">
        <div class="discover-anime-icon">🌸</div>
        <h3>Something Relaxing</h3>
        <p>
          Cozy worlds, slice-of-life stories, and anime that feel like comfort
          food.
        </p>
      </a>

      <a
        href="/blog/romance-anime-that-are-actually-worth-your-time"
        class="discover-anime-card"
      >
        <div class="discover-anime-icon">❤️</div>
        <h3>A Great Romance</h3>
        <p>
          Heartwarming relationships, emotional connections, and memorable love
          stories.
        </p>
      </a>

      <a
        href="/blog/10-new-anime-everyone-is-talking-about-right-now"
        class="discover-anime-card"
      >
        <div class="discover-anime-icon">🚀</div>
        <h3>Something New</h3>
        <p>
          Fresh releases, new seasons, and anime everyone's starting to talk
          about.
        </p>
      </a>

      <a
        href="/blog/fantasy-anime-that-will-transport-you-to-another-world"
        class="discover-anime-card"
      >
        <div class="discover-anime-icon">🌍</div>
        <h3>Take Me Somewhere New</h3>
        <p>Fantasy adventures, magical worlds, and unforgettable journeys.</p>
      </a>

      <a
        href="/blog/best-animes-online-for-beginners"
        class="discover-anime-card"
      >
        <div class="discover-anime-icon">🎓</div>
        <h3>I'm New To Anime</h3>
        <p>
          Beginner-friendly recommendations and perfect starting points for new
          fans.
        </p>
      </a>
    </div>
  </div>
</section>
