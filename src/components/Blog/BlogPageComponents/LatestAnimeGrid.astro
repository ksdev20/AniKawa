---
import { getCollection } from "astro:content";
import "./latest-anime-grid.css";

const posts = await getCollection("blog");
---
<section id="latest-articles" class="latest-articles-section">
  <div class="latest-articles-container">
    <div class="latest-articles-header">
      <span class="section-badge"> ✍️ Latest Articles </span>

      <h2 class="section-title">Fresh Reads For Anime Fans</h2>

      <p class="section-subtitle">
        Recommendations, hidden gems, watch guides, and editorials to help you
        discover your next favorite anime.
      </p>
    </div>

    <div class="latest-articles-grid">
      {
        posts.map((post) => (
          <a href={`/blog/${post.data.slug}`} class="article-card">
            <div class="article-card-image-wrapper">
              <img
                src={post.data.img}
                alt={post.data.title}
                loading="lazy"
                class="article-card-image"
              />
            </div>

            <div class="article-card-content">
              <div class="article-card-categories">
                {post.data.categoryList.slice(0, 2).map((category) => (
                  <span>{category}</span>
                ))}
              </div>

              <h3 class="article-card-title">{post.data.title}</h3>

              <p class="article-card-subtitle">{post.data.subTitle}</p>

              <div class="article-card-footer">
                <div class="article-card-meta">
                  <span>{post.data.date}</span>

                  {post.data.readMinutes && (
                    <>
                      <span>•</span>
                      <span>{post.data.readMinutes} min read</span>
                    </>
                  )}
                </div>

                <span class="article-card-arrow">→</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

