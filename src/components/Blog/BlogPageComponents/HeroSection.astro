---
import './herosection.css';
---
<section class="blog-hero-section">
  <div class="blog-hero-container">

    <span class="blog-hero-badge">
      📚 AniKawa Blog
    </span>

    <h1 class="blog-hero-title">
      Anime recommendations,
      <br />
      watch guides, hidden gems,
      <br />
      and thoughtful editorials.
    </h1>

    <p class="blog-hero-description">
      Discover carefully written anime recommendations, seasonal watch guides,
      hidden gems, beginner-friendly picks, and editor-curated articles designed
      to help you find your next favorite anime.
    </p>

    <div class="blog-hero-divider"></div>

    <a href="#latest-articles" class="blog-hero-button">
      Browse Articles
    </a>

  </div>
</section>