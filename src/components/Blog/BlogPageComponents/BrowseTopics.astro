---
import "./browse-topics.css";
---

<section class="anime-topics-section">
  <div class="anime-topics-container">
    <div class="anime-topics-header">
      <span class="section-badge"> 🎯 Explore Anime Topics </span>

      <h2 class="section-title">Discover Anime Through Every Angle</h2>

      <p class="section-subtitle">
        Whether you're searching for your next favorite anime, hidden gems,
        seasonal releases, or in-depth recommendations, start with the topic
        that interests you most.
      </p>
    </div>

    <div class="anime-topics-grid">
      <a href="/blog/category/anime-recommendations" class="anime-topic-card">
        <div class="anime-topic-icon">⭐</div>
        <h3>Anime Recommendations</h3>
        <p>Curated anime picks for every mood, genre, and experience level.</p>
      </a>

      <a href="/blog/category/hidden-gems" class="anime-topic-card">
        <div class="anime-topic-icon">💎</div>
        <h3>Hidden Gems</h3>
        <p>Discover underrated anime that deserve far more attention.</p>
      </a>

      <a href="/blog/category/watch-guides" class="anime-topic-card">
        <div class="anime-topic-icon">📺</div>
        <h3>Watch Guides</h3>
        <p>Learn which anime are worth watching and where to start.</p>
      </a>

      <a href="/blog/category/seasonal-anime" class="anime-topic-card">
        <div class="anime-topic-icon">🚀</div>
        <h3>Seasonal Anime</h3>
        <p>Follow the latest anime releases and trending seasonal shows.</p>
      </a>

      <a href="/blog/category/genre-spotlights" class="anime-topic-card">
        <div class="anime-topic-icon">⚔️</div>
        <h3>Genre Spotlights</h3>
        <p>Explore Action, Romance, Fantasy, Sci-Fi and more.</p>
      </a>

      <a href="/blog/category/anime-analysis" class="anime-topic-card">
        <div class="anime-topic-icon">🧠</div>
        <h3>Anime Analysis</h3>
        <p>Character breakdowns, themes, storytelling and deeper insights.</p>
      </a>
    </div>
  </div>
</section>
