---
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/Blog/BlogPageComponents/HeroSection.astro";
import FeaturedArticle from "../../components/Blog/BlogPageComponents/FeaturedArticle.astro";
import BrowseTopics from "../../components/Blog/BlogPageComponents/BrowseTopics.astro";
import DiscoverAnime from "../../components/Blog/BlogPageComponents/DiscoverAnime.astro";
import LatestAnimeGrid from "../../components/Blog/BlogPageComponents/LatestAnimeGrid.astro";
import AnimeDiscoveryCta from "../../components/Blog/BlogPageComponents/AnimeDiscoveryCta.astro";
import BlogIntro from "../../components/Blog/BlogPageComponents/BlogIntro.astro";
import BlogFaqSection from "../../components/Blog/BlogPageComponents/BlogFaqSection.astro";
import SEOHead from "../../components/SEO/SEOHead.astro";
import AdsSnippet from "../../components/Blog/AdsSnippet";
import { getCollection } from "astro:content";

const title =
  "AniKawa Blog - Anime Recommendations, Guides, Hidden Gems & Analysis";

const pageDes =
  "Discover anime recommendations, beginner guides, hidden gems, seasonal picks, watch guides, and thoughtful anime analysis. Find your next favorite anime with AniKawa.";

const pageKw = [
  "anime blog",
  "anime recommendations",
  "anime guides",
  "anime watch guides",
  "anime beginner guides",
  "hidden gem anime",
  "best anime to watch",
  "anime analysis",
  "anime genres",
  "seasonal anime",
  "anime articles",
  "anime discoveries",
  "anime suggestions",
  "what anime to watch",
  "AniKawa blog",
];

const pageUrl = "https://anikawa.fun/blog";

const currentThumbnail =
  "https://ik.imagekit.io/anikawa/Page%20Images/blog-homepage-thumbnail.avif";
const posts = await getCollection("blog");
---

<Fragment slot="head">
  <SEOHead
    title={title}
    description={pageDes}
    ogDescription={pageDes}
    imageUrl={currentThumbnail}
    url={pageUrl}
    keywords={pageKw}
  />
</Fragment>
<Layout>
  <div id="banner-ad-1" class="banner-ad-container"></div>
  <HeroSection />
  <FeaturedArticle featuredPost={posts[3]} />
  <div id="banner-ad-2" class="banner-ad-container"></div>
  <DiscoverAnime />
  <div id="banner-ad-3" class="banner-ad-container"></div>
  <LatestAnimeGrid />
  <BrowseTopics />
  <AnimeDiscoveryCta />
  <BlogIntro />
  <BlogFaqSection />
</Layout>
