---
export const prerender = true;
import { getCollection } from "astro:content";
import { BLOG_CATEGORY_CONFIG } from "../../../config/blog-category-page-config";
import "@/styles/pages/blog/category/category-page.css";
import Layout from "../../../layouts/Layout.astro";
import FeaturedArticle from "../../../components/Blog/BlogPage/FeaturedArticle.astro";
import BlogsGrid from "../../../components/Blog/CategoryPage/BlogsGrid.astro";
import SEOHead from "../../../components/SEO/SEOHead.astro";

export async function getStaticPaths() {
  return Object.keys(BLOG_CATEGORY_CONFIG).map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;

const categoryInfo =
  BLOG_CATEGORY_CONFIG[category as keyof typeof BLOG_CATEGORY_CONFIG];

if (!categoryInfo) {
  throw new Error(`Unknown category: ${category}`);
}
const allPosts = await getCollection("blog");

const slugifyCategory = (str: string) =>
  str.toLowerCase().trim().replaceAll("&", "and").replace(/\s+/g, "-");

const categoryPosts = allPosts
  .filter((post) =>
    post.data.categoryList.some((cat) => slugifyCategory(cat) === category),
  )
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

const featuredPost = categoryPosts.at(0);

const pageTitle = categoryInfo.metaTitle;

const pageDes = categoryInfo.metaDescription;

const pageUrl = `https://anikawa.fun/blog/category/${category}`;

const currentThumbnail =
  featuredPost?.data.imgLarge ||
  featuredPost?.data.img ||
  "https://ik.imagekit.io/anikawa/Page%20Images/blog-homepage-thumbnail.avif";

const pageKw = categoryInfo?.metaKeywords;
const otherTopics = Object.entries(BLOG_CATEGORY_CONFIG)
  .filter(([slug]) => slug !== category)
  .slice(0, 6);
---

<Fragment slot="head">
  <SEOHead
    title={pageTitle}
    description={pageDes}
    ogDescription={pageDes}
    imageUrl={currentThumbnail}
    url={pageUrl}
    keywords={pageKw}
  />
</Fragment>
<Layout>
  <!-- <CategoryHero categoryInfo={categoryInfo} posts={categoryPosts} /> -->
  <section class="category-hero-section">
    <div class="category-hero-container">
      <div class="category-hero-content">
        <span class="category-hero-badge">
          {categoryInfo.emoji} Blog Category
        </span>

        <h1 class="category-hero-title">
          {categoryInfo.title}
        </h1>

        <p class="category-hero-description">
          {categoryInfo.description}
        </p>

        <div class="category-hero-stats">
          <div class="category-stat">
            <span class="category-stat-value">
              {categoryPosts.length}
            </span>

            <span class="category-stat-label"> Articles </span>
          </div>

          <div class="category-stat">
            <span class="category-stat-value"> Curated </span>

            <span class="category-stat-label"> By AniKawa </span>
          </div>

          <div class="category-stat">
            <span class="category-stat-value"> Updated </span>

            <span class="category-stat-label"> Regularly </span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <FeaturedArticle featuredPost={featuredPost} />
  <BlogsGrid categoryInfo={categoryInfo} posts={categoryPosts} />
  <!-- <ExploreOtherTopics currentCategory={category} /> -->
  <section class="explore-topics-section">
    <div class="explore-topics-container">
      <div class="explore-topics-header">
        <span class="section-badge"> 🔍 Discover More </span>

        <h2 class="section-title">You Might Also Like</h2>

        <p class="section-subtitle">
          Explore other anime topics, recommendations, and guides curated by
          AniKawa.
        </p>
      </div>

      <div class="explore-topics-grid">
        {
          otherTopics.map(([slug, topic]) => (
            <a href={`/blog/category/${slug}`} class="explore-topic-card">
              <div class="explore-topic-icon">{topic.emoji}</div>

              <div class="explore-topic-content">
                <h3 class="explore-topic-title">{topic.title}</h3>

                <p class="explore-topic-description">{topic.description}</p>
              </div>

              <div class="explore-topic-arrow">→</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <!-- <AboutThisCategory categoryInfo={categoryInfo} /> -->
  <section class="about-category-section">
    <div class="about-category-container">
      <div class="about-category-header">
        <span class="section-badge"> 📖 Learn More </span>

        <h2 class="section-title">
          {categoryInfo.aboutTitle}
        </h2>
      </div>

      <div class="about-category-content">
        <p>
          {categoryInfo.aboutContent}
        </p>
      </div>
    </div>
  </section>
</Layout>
