---
export const prerender = true;
import { getCollection } from "astro:content";
import { BLOG_CATEGORY_CONFIG } from "../../../config/blog-category-page-config";
import Layout from "../../../layouts/Layout.astro";
import CategoryHero from "../../../components/Blog/CategoryPageComponents/CategoryHero.astro";
import FeaturedArticle from "../../../components/Blog/BlogPageComponents/FeaturedArticle.astro";
import BlogsGrid from "../../../components/Blog/CategoryPageComponents/BlogsGrid.astro";
import ExploreOtherTopics from "../../../components/Blog/CategoryPageComponents/ExploreOtherTopics.astro";
import AboutThisCategory from "../../../components/Blog/CategoryPageComponents/AboutThisCategory.astro";
import SEOHead from "../../../components/SEO/SEOHead.astro";

export async function getStaticPaths() {
  return Object.keys(BLOG_CATEGORY_CONFIG).map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;

const categoryInfo =
  BLOG_CATEGORY_CONFIG[category as keyof typeof BLOG_CATEGORY_CONFIG];

if (!categoryInfo) {
  throw new Error(`Unknown category: ${category}`);
}
console.log("working till now");
const allPosts = await getCollection("blog");

const slugifyCategory = (str: string) =>
  str.toLowerCase().trim().replaceAll("&", "and").replace(/\s+/g, "-");

const categoryPosts = allPosts
  .filter((post) =>
    post.data.categoryList.some((cat) => slugifyCategory(cat) === category),
  )
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

const featuredPost = categoryPosts.at(0);

const pageTitle = categoryInfo.metaTitle;

const pageDes =
  categoryInfo.metaDescription;

const pageUrl = `https://anikawa.fun/blog/category/${category}`;

const currentThumbnail =
  featuredPost?.data.imgLarge ||
  featuredPost?.data.img ||
  "https://ik.imagekit.io/anikawa/Page%20Images/blog-homepage-thumbnail.avif";

const pageKw = categoryInfo?.metaKeywords;
---

<Fragment slot="head">
  <SEOHead
    title={pageTitle}
    description={pageDes}
    ogDescription={pageDes}
    imageUrl={currentThumbnail}
    url={pageUrl}
    keywords={pageKw}
  />
</Fragment>
<Layout>
  <CategoryHero categoryInfo={categoryInfo} posts={categoryPosts} />
  <div id="banner-ad-1" class="banner-ad-container"></div>
  <FeaturedArticle featuredPost={featuredPost} />
  <div id="banner-ad-2" class="banner-ad-container"></div>
  <BlogsGrid categoryInfo={categoryInfo} posts={categoryPosts} />
  <ExploreOtherTopics currentCategory={category} />
  <AboutThisCategory categoryInfo={categoryInfo} />
</Layout>
