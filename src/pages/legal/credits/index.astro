    <meta
      name="description"
      content="Credits and attributions for third-party services and resources used by Anikawa."
    />

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 40px 20px;
        background: #000;
        color: #f1f1f1;
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.7;
      }

      .container {
        max-width: 900px;
        margin: 0 auto;
      }

      h1 {
        color: #ffcc00;
        margin-bottom: 10px;
      }

      h2 {
        color: #ffcc00;
        margin-top: 40px;
        margin-bottom: 15px;
      }

      p {
        margin: 12px 0;
      }

      a {
        color: #66ccff;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .logo {
        max-width: 180px;
        height: auto;
        display: block;
        margin: 15px 0;
      }

