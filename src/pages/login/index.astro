---
import Footer from "../../components/Footer/Footer";
import AuthForm from "../../components/auth/AuthForm";
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width initial-scale=1.0" />
        <title>Login to Your Account</title>
        <link rel="icon" type="image/png" href="/icon.png" />
        <style>
            .topbar {
                padding: 25px 0;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                height: 80px;
                background-color: rgb(10, 10, 10);
            }

            .website-logo {
                height: 100%;
                width: auto;
            }
        </style>
    </head>

    <body>
        <header class="topbar">
            <a href="../index.html" class="website-logo">
                <img class="website-logo" src="/logo.png" alt="Website logo of Anikawa"/>
            </a>
        </header>
        <AuthForm
            keyword="l"
            title="Log In"
            buttonLabel="LOG IN"
            apiEndPoint="login"
            client:load
        />
        <Footer />
    </body>
</html>
