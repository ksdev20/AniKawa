---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar/Navbar";
import HeroSection from "../components/HeroSection/HeroSection.astro";
import AnimeSliderStatic from "../components/AnimeSlider/AnimeSliderStatic.astro";
import AnimeCard2 from "../components/AnimeCard2/AnimeCard2.astro";
import Footer from "../components/Footer/Footer";
import FetchFromDb from "../components/auth/FetchFromDb";

const usedTitlesGlobal: string[] = [];
const usedTitlesAC2: string[] = [];

export interface Props {
	info: {
		bigH: string;
		smallH: string;
		filterName: string;
		usedTitlesGlobal: string[];
	};
	anime: any;
	category: string;
}

const SliderData = [
	{
		bigH: "Watch HD Anime Shows 100% Ad-Free!",
		smallH: "These shows are one of the most popular in the last 5 years.",
		filterName: "topRatedLast5",
		usedTitlesGlobal
	},
	{
		bigH: "Hello Ballo Moda ",
		smallH: "Chota Bhai",
		filterName: "beginnerAnime",
		usedTitlesGlobal
	},
	{
		bigH: "Hello Ballo Bhai",
		smallH: "Chota Bhai",
		filterName: "sameMonthAnimeGen",
		usedTitlesGlobal
	},
	{
		bigH: "Hello  Moda Bhai",
		smallH: "Chota Bhai",
		filterName: "isPopular",
		usedTitlesGlobal
	},
	{
		bigH: " Ballo Moda Bhai",
		smallH: "Chota Bhai",
		filterName: "actionPopular",
		usedTitlesGlobal
	},
	{
		bigH: "Hellordtrdy Ballo Moda Bhai",
		smallH: "Chota Bhai",
		filterName: "adventurePopular",
		usedTitlesGlobal
	},
	{
		bigH: "Amazing Romance Anime",
		smallH: "These anime with over 7 ★ so they're a must watch for romance lovers !",
		filterName: "romancePopular",
		usedTitlesGlobal
	},
];
const AC2Data= ["Action", "Action", "Sports", "Romance", "Comedy", "Adventure", "Fantasy"];

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<FetchFromDb client:load />
	<Navbar client:load />
	<HeroSection />
	<AnimeSliderStatic
		info={SliderData[0]}
	/>
	<AnimeCard2 category={AC2Data[0]} usedTitlesAC2={usedTitlesAC2}/>
	<AnimeSliderStatic
		info={SliderData[1]}
	/>
	<AnimeSliderStatic
		info={SliderData[2]}
	/>
	<AnimeCard2 category={AC2Data[1]} usedTitlesAC2={usedTitlesAC2}/>
	<AnimeSliderStatic
		info={SliderData[3]}
	/>
	<AnimeCard2 category={AC2Data[2]} usedTitlesAC2={usedTitlesAC2}/>
	<AnimeCard2 category={AC2Data[3]} usedTitlesAC2={usedTitlesAC2}/>
	<AnimeSliderStatic
		info={SliderData[4]}
	/>
	<AnimeCard2 category={AC2Data[4]} usedTitlesAC2={usedTitlesAC2}/>
	<AnimeSliderStatic
		info={SliderData[5]}
	/>
	<AnimeCard2 category={AC2Data[5]} usedTitlesAC2={usedTitlesAC2} />
	<AnimeCard2 category={AC2Data[6]} usedTitlesAC2={usedTitlesAC2} />
	<AnimeSliderStatic
		info={SliderData[6]}
	/>
	<Footer />
</Layout>
