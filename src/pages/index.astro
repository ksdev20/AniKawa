    </div>
  </div>
  <HeroSectionTmdb />
  <div id="banner-ad-1" class="banner-ad-container"></div>
  <!-- Banner Homepage 1 -->
  <script>
    (function (azifv) {
      var d = document,
        s = d.createElement("script"),
        l = d.getElementById("banner-ad-1");
      s.settings = azifv || {};
      s.src =
        "\/\/deliciouslip.com\/baXjV.sndHGQln0_YTW\/cY\/eeBmJ9SubZGUGlxkbPuTxc\/xvNNzKItzJMnDQUPtUNiz\/Eh3\/MejBMXw\/OrQS";
      s.async = true;
      s.referrerPolicy = "no-referrer-when-downgrade";
      l.parentNode.insertBefore(s, l);
    })({});
  </script>
  <HomepageIntroSection />
  <AnimeSliderStatic info={SliderData[0]} />
  <div id="banner-ad-2" class="banner-ad-container"></div>
