---
import Layout from "../layouts/Layout.astro";
import HeroSectionTmdb from "../components/HeroSection/HeroSectionTmdb.astro";
import ShareAnikawa from "@/components/HomePageValueSections/ShareAnikawa.astro";
import ContinueWatchingSlider from "@/components/HomePageValueSections/ContinueWatchingSlider";
import HomepageIntroSection from "../components/HomePageValueSections/HomepageIntroSection.astro";
import AnimeSliderStatic from "../components/AnimeSlider/AnimeSliderStatic.astro";
import WhyAnikawa from "../components/HomePageValueSections/WhyAnikawa.astro";
import RecommendedByAnikawa from "../components/HomePageValueSections/RecommendedByAnikawa.astro";
import { AnimeSliderClient } from "@/components/AnimeSlider/AnimeSliderClient";
import BrowseByCategory from "../components/HomePageValueSections/BrowseByCategory.astro";
import LatestEpisodes from "../components/HomePageValueSections/LatestEpisodes.astro";
import PopularAnimeSection from "../components/HomePageValueSections/PopularAnimeSection.astro";
import NewReleasesSection from "../components/HomePageValueSections/NewReleasesSection.astro";
import BlogsSectionHomepage from "../components/Blog/BlogsSectionHomepage.astro";
import FaqSection from "../components/HomePageValueSections/FaqSection.astro";
import { BlogSection2, recentlyWatched, SliderData } from "@/config/homepage";
import AnimeDiscoveryGateway from "@/components/HomePageValueSections/AnimeDiscoveryGateway.astro";
import AnikawaIntro from "@/components/HomePageValueSections/AnikawaIntro.astro";
---

<Layout>
  <div class="announcement-bar-top">
    <div class="abt-container">
      <p>
        Big Update Coming Soon ! Latest Anime Series and Episodes will be added
      </p>
    </div>
  </div>
  <HeroSectionTmdb />
  <ContinueWatchingSlider client:load />
  <AnikawaIntro />
  <AnimeDiscoveryGateway />
  <AnimeSliderStatic info={SliderData[0]} />
  <RecommendedByAnikawa info={SliderData[1]} />
  <LatestEpisodes />
  <PopularAnimeSection />
  <NewReleasesSection />
  <AnimeSliderClient info={recentlyWatched} client:visible />
  <BlogsSectionHomepage info={BlogSection2} />
  <ShareAnikawa />
  <FaqSection />
</Layout>
