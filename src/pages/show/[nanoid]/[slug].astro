---
import { getAnimeById } from "../../../filters/getAnimeById";
import { type Anime } from "../../../types/mergedListTypes";
import SEOHead from "../../../components/SEO/SEOHead.astro";
import "../../../styles/pages/show/animePagetw.css";
import "../../../styles/pages/show/new-anime-page.css";
import "../../../styles/index.css";
import { getOptimizedImageUrl } from "../../../utils/imageSizing";
import SortBtnHandler from "../../../components/ButtonHandlers/SortBtnHandler";
import EpisodeCard from "../../../components/EpisodeCard/EpisodeCard";
import AnimeSliderStatic from "../../../components/AnimeSlider/AnimeSliderStatic.astro";
import { Icon } from "../../../icons/icons";
import { frontendUrl } from "../../../global_assets/globalPaths";
import Layout from "../../../layouts/Layout.astro";
import FavoriteButton from "@/components/AnimePage/FavoriteButton";
import AddAnimeToList from "@/components/AnimePage/AddAnimeToList";
const { nanoid, slug } = Astro.params;
const sort = Astro.url.searchParams.get("sort") ?? "old";
const anime = (await getAnimeById(nanoid)) as Anime | null;

if (anime == null || !anime.episodes == null) {
  return new Response(null, {
    status: 302,
    headers: {
      Location: "/404",
    },
  });
}

const {
  title = "Untitled",
  tagline,
  season_poster = anime?.poster ?? "/anime-image-alt.png",
  description = "No Description",
  scoreAlt,
  runtime = "N/A",
  status = "N/A",
  startDate = "N/A",
  seasons = 1,
  genres,
  genres: genresA = [],
  season,
  episodes: episodeList,
  keywords,
  anikawaReview,
  animeInsights,
  whoShouldWatch,
  whatMakesItSpecial,
  watchOrder,
  faq,
  relatedArticles,
  characters,
  staff,
  links
} = anime ?? {};

const sortedEpList = sort == "new" ? [...episodeList].reverse() : episodeList;

const titleAlt = seasons > 1 ? `${title} Season - ${season}` : title;
const language = "Subtitled";
const episodes = episodeList.length;
const usedTitlesGlobal = [title, title, title];

const pageDescription = `Stream ${title} online in high quality — No ads on Anikawa. ${description}`;
const pageUrl = `${frontendUrl}/show/${nanoid}/${slug}`;
---

<Fragment slot="head">
  <SEOHead
    title={`Watch ${titleAlt} on AniKawa for Free !`}
    description={pageDescription}
    ogDescription={pageDescription}
    imageUrl={season_poster}
    url={pageUrl}
    keywords={keywords}
  />
</Fragment>
<Layout>
  <!-- Hero Section -->

  <section class="anime-hero">
    <div class="hero-backdrop-overlay"></div>

    <div class="hero-container">
      <div class="hero-poster-column">
        <img
          src={getOptimizedImageUrl(season_poster, 500)}
          alt={`Poster of ${titleAlt}`}
          class="hero-poster"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="hero-content-column">
        <div class="hero-badges">
          {
            genres?.slice(0, 4).map((genre: string) => (
              <a href={`/category/${genre}`} class="genre-badge">
                {genre}
              </a>
            ))
          }
        </div>

        <h1 class="hero-title">
          {titleAlt}
        </h1>

        {tagline && <p class="hero-tagline">{tagline}</p>}

        <div class="hero-meta-row">
          <span>{scoreAlt}</span>
          <span>•</span>
          <span>{episodes} Episodes</span>
          <span>•</span>
          <span>{runtime}</span>
          <span>•</span>
          <span>{status}</span>
        </div>

        <p class="hero-summary">
          {description}
        </p>

        <div class="hero-actions">
          <a href="#episodes-section" class="watch-season-btn">
            Watch Episodes
          </a>

          <FavoriteButton type="anime" itemId={nanoid as string}  client:load/>

          <AddAnimeToList
    animeNanoid={anime.nanoid}
    client:load
/>
        </div>

        <div class="hero-facts-grid">
          <div class="fact-card">
            <span class="fact-label">Season</span>
            <span class="fact-value">{season}</span>
          </div>

          <div class="fact-card">
            <span class="fact-label">Episodes</span>
            <span class="fact-value">{episodes}</span>
          </div>

          <div class="fact-card">
            <span class="fact-label">Aired</span>
            <span class="fact-value">{startDate}</span>
          </div>

          <div class="fact-card">
            <span class="fact-label">Status</span>
            <span class="fact-value">{status}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EPISODES GRID -->
  <section id="episodes-section" class="episodes-section">
    <header class="top-controls">
      <div class="top-controls-btn">
        <Icon name="arrowdown" size={30} className="arrow-down" />
        <h2 id="season-text" class="season-text">
          S{season}: {title}
        </h2>
      </div>
      <SortBtnHandler client:load />
    </header>
    <ul class="episodes-list">
      {
        sortedEpList?.map((e: any) => {
          const epData: any = {
            animeTitle: title,
            language,
            animenanoid: nanoid,
            animeslug: slug,
            ...e,
          };

          return <EpisodeCard epData={epData} />;
        })
      }
    </ul>
    <div class="episode-list-endline">Episode thumbnails sourced via YouTube API.</div>
  </section>

  <div id="banner-ad-1" class="banner-ad-container"></div>
  <!-- ANIKAWA REVIEW SECTION -->
  {
    anikawaReview && (
      <section class="anikawa-review-section">
        <div class="section-heading">
          <span class="section-badge"> ⭐ AniKawa Review </span>

          <h2 class="section-title">Why Watch this Anime?</h2>
        </div>

        <div class="review-card">
          <div class="review-verdict">
            <span class="verdict-label"> AniKawa Verdict </span>

            <p class="verdict-text">{anikawaReview.verdict}</p>
          </div>

          <p class="review-text">{anikawaReview.review}</p>

          <div class="review-grid">
            <div class="review-column">
              <h3 class="review-subtitle">Highlights</h3>

              <ul class="review-list">
                {anikawaReview.strengths.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

            <div class="review-column">
              <h3 class="review-subtitle">Recommended For</h3>

              <ul class="review-list">
                {anikawaReview.recommendedFor.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    watchOrder && (
      <section class="watch-order-section">
        <div class="watch-order-header">
          <span class="watch-order-eyebrow">WATCH GUIDE</span>

          <h2 class="watch-order-title">Watch Order for this Anime Series</h2>

          <p class="watch-order-description">{watchOrder.note}</p>
        </div>

        <div class="watch-order-list">
          {watchOrder.entries.map((entry) => (
            <div class="watch-order-item">
              <div class="watch-order-number">{entry.order}</div>

              <div class="watch-order-content">
                <h3 class="watch-order-item-title">{entry.title}</h3>

                <span class="watch-order-item-type">{entry.type}</span>
              </div>

              {entry.recommended && (
                <span class="recommended-badge">Recommended</span>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }

{
  characters && characters.length > 0 && (
    <section class="characters-section">

      <div class="section-heading-small">

        <h2 class="section-title-small">
          <span class="section-icon">
            ♧
          </span>

          Characters & Voice Actors
        </h2>

      </div>


      <div class="characters-grid">

        {
          characters.map((character: any) => (

            <article class="character-mini-card">


              <!-- Character -->

              <a
                class="character-mini-profile"
              >

                <img
                  src={character.image}
                  alt={character.name}
                  loading="lazy"
                  class="character-mini-image"
                />


                <div class="character-mini-info">

                  <h3 class="character-mini-name">
                    {character.name}
                  </h3>

                  <span class="character-mini-role">
                    {character.role ?? "Character"}
                  </span>

                </div>

              </a>



              <!-- Voice Actor -->

              {
                character.voiceActor && (

                  <a
                    class="voice-mini-profile"
                  >

                    <div class="voice-mini-info">

                      <span class="voice-mini-name">
                        {character.voiceActor.name}
                      </span>

                      <span class="voice-mini-language">
                        JP
                      </span>

                    </div>


                    <img
                      src={character.voiceActor.image}
                      alt={character.voiceActor.name}
                      loading="lazy"
                      class="voice-mini-image"
                    />


                  </a>

                )
              }


            </article>

          ))
        }


      </div>


    </section>
  )
}


{
  staff && staff.length > 0 && (
    <section class="staff-section">

      <div class="section-heading-small">

        <h2 class="section-title-small">

          <span class="section-icon">
            🎬
          </span>

          Staff

        </h2>

      </div>



      <div class="staff-grid">

        {
          staff.map((person: any) => (

            <article class="staff-card">

              <a
                class="staff-profile"
              >

                <img
                  src={person.image}
                  alt={person.name}
                  loading="lazy"
                  class="staff-image"
                />


                <div class="staff-info">

                  <h3 class="staff-name">
                    {person.name}
                  </h3>


                  <span class="staff-role">
                    {person.role ?? "Staff"}
                  </span>


                </div>


              </a>


            </article>

          ))
        }


      </div>


    </section>
  )
}

{
  links && links.length > 0 && (
    <section class="anime-links-section">

      <div class="section-heading-small">

        <h2 class="section-title-small">
          <span class="section-icon">
            🔗
          </span>

          Links
        </h2>

      </div>



      <div class="links-container">

        {
          links.map((link: any) => (

            <a
              target="_blank"
              rel="noopener noreferrer"
              class="external-link-pill"
            >

              {
                link.icon && (
                  <img
                    src={link.icon}
                    alt=""
                    class="link-icon"
                  />
                )
              }


              <span class="link-name">
                {link.name}
              </span>


              <span class="external-icon">
                ↗
              </span>


            </a>

          ))
        }


      </div>


    </section>
  )
}

<!-- OTHER SEASONS -->
  <section class="more-section">
    <h2 class="sr-only">Other Seasons of this Anime</h2>
    <AnimeSliderStatic
      info={{
        bigH: "Other Seasons",
        forAnimePageSeasons: true,
        animeTitle: title,
        toNotInclude: nanoid,
      }}
    />
  </section>

  <section class="more-section">
    <h2 class="sr-only">More anime like this</h2>
    <AnimeSliderStatic
      info={{
        bigH: "More Like This",
        smallH: "",
        filterName: "matchCategories",
        genresA,
        usedTitlesGlobal: usedTitlesGlobal,
      }}
    />
  </section>

  {
    whoShouldWatch && (
      <section class="watch-audience-section">
        <div class="watch-audience-header">
          <span class="watch-audience-eyebrow">RECOMMENDATION GUIDE</span>

          <h2 class="watch-audience-title">Who Should Watch this Anime?</h2>
          <p class="watch-audience-description">
            Not every anime is for everyone. Here's who is most likely to enjoy
            this series.
          </p>
        </div>

        <div class="watch-audience-grid">
          <div class="audience-card">
            <h3 class="audience-card-title">Perfect For</h3>

            <ul class="audience-list positive">
              {whoShouldWatch.perfectFor.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="audience-card">
            <h3 class="audience-card-title">Maybe Skip If</h3>

            <ul class="audience-list neutral">
              {whoShouldWatch.maybeSkipIf.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="viewing-summary-card">
          <div class="summary-item">
            <span class="summary-label">Viewing Mood</span>

            <span class="summary-value">{whoShouldWatch.viewingMood}</span>
          </div>
          <div class="summary-item">
            <span class="summary-label">Commitment Level</span>

            <span class="summary-value">{whoShouldWatch.commitmentLevel}</span>
          </div>
        </div>
      </section>
    )
  }
  <div id="banner-ad-2" class="banner-ad-container"></div>
  {
    whatMakesItSpecial && (
      <section class="special-section">
        <div class="special-header">
          <span class="special-eyebrow">STANDOUT FEATURES</span>

          <h2 class="special-title">What Makes this Anime Special?</h2>

          <p class="special-description">{whatMakesItSpecial.summary}</p>
        </div>

        <div class="special-grid">
          {whatMakesItSpecial.standoutElements.map((item) => (
            <article class="special-card">
              <h3 class="special-card-title">{item.title}</h3>

              <p class="special-card-description">{item.description}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <div id="banner-ad-3" class="banner-ad-container"></div>

  {
    animeInsights && (
      <section class="anime-insights-section">
        <div class="insights-header">
          <span class="insights-eyebrow">DID YOU KNOW?</span>
          <h2 class="insights-title">{animeInsights.title}</h2>
          <p class="insights-description">
            Interesting facts, production notes, and lesser-known details about
            this Anime
          </p>
        </div>

        <div class="insights-card">
          <div class="insights-timeline">
            {animeInsights.facts.map((fact, index) => (
              <div class="insight-item">
                <div class="insight-marker">{index + 1}</div>

                <div class="insight-content">
                  <p>{fact}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    relatedArticles && relatedArticles.articles.length > 0 && (
      <section class="related-articles-section">
        <div class="related-articles-header">
          <span class="related-eyebrow">KEEP EXPLORING</span>

          <h2 class="related-title">{relatedArticles.heading}</h2>

          <p class="related-description">{relatedArticles.intro}</p>
        </div>

        <div class="related-grid">
          {relatedArticles.articles.map((article) => (
            <a href={`/blog/${article.slug}`} class="related-card group">
              <div class="related-meta">
                <span class="related-category">{article.category}</span>

                <span class="related-reading-time">{article.readingTime}</span>
              </div>

              <h3 class="related-card-title">{article.title}</h3>

              <p class="related-card-description">{article.description}</p>

              <span class="related-link">Read Article →</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    faq && (
      <section class="anime-faq-section">
        <header class="anime-faq-header">
          {/* <span class="faq-eyebrow">FREQUENTLY ASKED QUESTIONS</span> */}

          <h2 class="anime-faq-title">Questions About this Anime</h2>

          {faq.intro && <p class="anime-faq-description">{faq.intro}</p>}
        </header>

        <div class="anime-faq-list">
          {faq.questions.map((item) => (
            <details class="anime-faq-item">
              <summary>
                <span>{item.question}</span>
                <span class="anime-faq-icon">+</span>
              </summary>

              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }
</Layout>
