---
import "../../../../styles/category/subcat.css";
import "../../../../components/watchlist-history/wat-his.css";
import Navbar from "../../../../components/Navbar/Navbar";
import Footer from "../../../../components/Footer/Footer";
import { getFilteredAnime } from "../../../../filters/animeFilterMainTmdbVer";
import AnimeCardStatic from "../../../../components/AnimeCard/AnimeCardStaticTmdbVer.astro";
import SEOHead from "../../../../components/SEO/SEOHead.astro";

const { mainCategory, subCategory } = Astro.params;
const finalArray = getFilteredAnime("matchCategories", {
  categoryA: mainCategory,
  categoryB: subCategory,
  forSubCategory: true,
});

const pageTitle = `${mainCategory} / ${subCategory} Anime`;
const pageDescription = `Browse the ultimate list of ${mainCategory} + ${subCategory} anime. From cult classics to new releases, Anikawa brings you a fan-curated experience with no ads.`;
const keywords = `${mainCategory} ${subCategory} anime, ${mainCategory} anime, ${subCategory} anime, watch ${mainCategory} ${subCategory} anime online, Anikawa`;
const pageUrl = `https://anikawa.vercel.app/category/${mainCategory}/${subCategory}`;
const backdrop = `https://anikawa.vercel.app/anikawa-sub-category-og-img-pc.png`;
---

<html>
  <SEOHead
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    ,
    ogDescription={pageDescription}
    ,
    url={pageUrl}
    ,
    imageUrl={backdrop}
  />
  <body>
    <Navbar client:load />
    <main class="main-root">
      <section class="sub-cat-main">
        <header class="sub-cat-main">
          <div class="sub-cat-top">
            <h1 class="sr-only">
              {mainCategory} + {subCategory} Anime List | Anikawa
            </h1>
            <a
              id="main-cat-name"
              class="main-cat-link"
              href={`/category/${mainCategory}`}>{mainCategory}</a
            >
            <div id="sub-cat-name" class="sub-cat-name">
              {subCategory}
            </div>
          </div>
        </header>
        <ul id="sub-cat-anime-list" class="new-pop-anime-list">
          {
            finalArray.map((anime, i) => (
              <AnimeCardStatic anime={anime} fornewpop={true} />
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
