---
import "../../../styles/category/category.css";
import Navbar from "../../../components/Navbar/Navbar";
import Footer from "../../../components/Footer/Footer";
import AnimeSliderStatic from "../../../components/AnimeSlider/AnimeSliderStatic.astro";
import SEOHead from "../../../components/SEO/SEOHead.astro";

const { mainCategory } = Astro.params;

const categories = [
  "Popular",
  "New",
  "Action",
  "Adventure",
  "Comedy",
  "Drama",
  "Fantasy",
  "Music",
  "Romance",
  "Sci-Fi",
  "Sports",
  "Supernatural",
  "Thriller",
];

const pageTitle = `${mainCategory} Anime`;
const pageDescription = `Explore the best ${mainCategory} anime handpicked for fans. Discover trending series, hidden gems, and timeless classics across genres.`;
const keywords = `${mainCategory} anime, ${mainCategory} anime list, ${mainCategory} anime recommendations, watch ${mainCategory} anime online, Anikawa`;
const pageUrl = `https://anikawa.vercel.app/category/${mainCategory}`;
const backdrop = `https://anikawa.vercel.app/anikawa-category-og-img-pc.png`;
---

<html lang="en">
  <SEOHead
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    ,
    ogDescription={pageDescription}
    ,
    url={pageUrl}
    ,
    imageUrl={backdrop}
  />
  <body>
    <Navbar client:load />
    <main class="main-root">
      <section class="category-main">
        <header class="category-top">
          <h2 class="category-text">
            {mainCategory}
          </h2>
          <p class="category-text cat-des"></p>
        </header>
      </section>
      <div class="category-main">
        {
          categories.map((cat) => {
            if (cat == mainCategory) return null;

            return (
              <AnimeSliderStatic
                info={{
                  bigH: cat,
                  smallH: "",
                  filterName: "matchCategories",
                  categoryA: mainCategory,
                  categoryB: cat,
                  forCategoryPage: true
                }}
              />
            );
          })
        }
      </div>
    </main>
    <Footer />
  </body>

</html>
