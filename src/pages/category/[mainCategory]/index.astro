---
import "../../../styles/category/category.css";
import Navbar from "../../../components/Navbar/Navbar";
import Footer from "../../../components/Footer/Footer";
import AnimeSliderStatic from "../../../components/AnimeSlider/AnimeSliderStatic.astro";

const { mainCategory } = Astro.params;

const categories = [
    "Popular",
    "New",
    "Action",
    "Adventure",
    "Comedy",
    "Drama",
    "Fantasy",
    "Music",
    "Romance",
    "Sci-Fi",
    "Sports",
    "Supernatural",
    "Thriller",
];
---

<html>
    <head>
        <meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/icon.png" />
        <link rel="icon" type="image/png" href="/icon.png" />
        <title></title>
    </head>
    <body>
        <Navbar client:load />
        <main class="main-root">
            <div class="category-main">
                <div class="category-top">
                    <div id="category-text" class="category-text">
                        {mainCategory}
                    </div>
                    <div
                        id="category-text-cat-des"
                        class="category-text cat-des"
                    >
                    </div>
                </div>
            </div>
            <div class="category-main">
                {
                    categories.map((cat) => {
                        if (cat == mainCategory) return <div />;

                        return (
                            <AnimeSliderStatic
                                info={{
                                    bigH: cat,
                                    smallH: "",
                                    filterName: "matchCategories",
                                    categoryA: mainCategory,
                                    categoryB: cat,
                                }}
                            />
                        );
                    })
                }
            </div>
        </main>
        <Footer />
    </body>
</html>
