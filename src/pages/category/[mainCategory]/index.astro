---
import { categories } from "../../../config/categoryConfig";
import "../../../styles/category/category.css";
import AnimeSliderStatic from "../../../components/AnimeSlider/AnimeSliderStatic.astro";
import SEOHead from "../../../components/SEO/SEOHead.astro";
import { getCatHead } from "../../../config/headConfig";
import Layout from "../../../layouts/Layout.astro";
const { mainCategory } = Astro.params;

const { pageTitle, pageDescription, keywords, pageUrl, backdrop } = getCatHead(
  mainCategory as string,
);
---

<Fragment slot="head">
  <SEOHead
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    ,
    ogDescription={pageDescription}
    ,
    url={pageUrl}
    ,
    imageUrl={backdrop}
  />
</Fragment>
<Layout>
  <main class="main-root">
    <div id="banner-ad-1" class="banner-ad-container"></div>
    <div id="banner-ad-2" class="banner-ad-container"></div>
    <section class="category-main">
      <header class="category-top">
        <h2 class="category-text">
          {mainCategory}
        </h2>
        <h3 class="category-text cat-des">
          Start Watching {mainCategory} Hits
        </h3>
      </header>
    </section>
    <div class="category-main">
      {
        categories.map((cat) => {
          if (cat == mainCategory) return null;

          return (
            <AnimeSliderStatic
              info={{
                bigH: cat,
                smallH: "",
                filterName: "matchCategories",
                categoryA: mainCategory,
                categoryB: cat,
                forCategoryPage: true,
              }}
            />
          );
        })
      }
    </div>
  </main>
</Layout>
