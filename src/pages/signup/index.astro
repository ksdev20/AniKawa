---
import Footer from "../../components/Footer/Footer";
import AuthForm from "../../components/auth/AuthForm";
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width initial-scale=1.0" />
        <title>Register for Anikawa</title>
        <link rel="icon" type="image/png" href="/icon.png" />
        <style>
            .topbar {
                padding: 25px 0;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                height: 80px;
                background-color: rgb(10, 10, 10);
            }

            .website-logo {
                height: 100%;
                width: auto;
            }
        </style>
    </head>

    <body>
        <div class="topbar">
            <a href="/" class="website-logo"
                ><img class="website-logo" src="/logo.png" /></a
            >
        </div>
        <AuthForm
            keyword="s"
            title="Create Account"
            buttonLabel="SIGN UP"
            apiEndPoint="signup"
            client:load
        />
        <Footer />
    </body>
</html>
