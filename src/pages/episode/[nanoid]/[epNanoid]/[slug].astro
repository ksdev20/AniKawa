---
import Layout from "@/layouts/Layout.astro";
import "@/styles/pages/episode/episode-pagetw.css";
import { type Anime } from "@/types/mergedListTypes";
import { getAnimeById } from "@/filters/getAnimeById";
import RecentlyWatchedTracker from "@/components/EpisodePage/RecentlyWatchedTracker";
import SEOHead from "@/components/SEO/SEOHead.astro";
import { getEpImg } from "@/utils/getEpImgFallback";
import { frontendUrl } from "@/global_assets/globalPaths";
import YouTubeProgressTracker from "@/components/EpisodePage/YouTubeProgressTracker";
import CommentSection from "@/components/Comments/CommentSection";
import ReactionWidget from "@/components/EpisodePage/ReactionWidget";
import EpisodeVotes from "@/components/EpisodePage/EpisodeVotes";

const { nanoid, epNanoid, slug } = Astro.params;
const anime = (await getAnimeById(nanoid)) as Anime | null;
const episode = anime?.episodes?.find((e) => e?.nanoid == epNanoid);

if (!anime || !episode || slug == "n-a") {
  return new Response(null, {
    status: 302,
    headers: {
      Location: "/404",
    },
  });
}

//anime details
const { slug: animeslug = "n-a", title: animeTitle = "Untitled" } = anime ?? {};
const language = "Subtitled";

//current episode details
const {
  epNum,
  url,
  titleAlt: episodeTitle,
  description = "No description",
  air_date,
  vote_average,
  summary,
  importance,
  facts,
  faq,
} = episode ?? {};

const currentThumbnail = getEpImg(episode);

const totalEpisodes = anime?.episodes.length;
const progressPercentage = ((epNum / totalEpisodes) * 100).toFixed(0);
//to send to episode change cards
const prevObj = anime?.episodes?.[epNum - 2];
const nextObj = anime?.episodes?.[epNum];

const currentIndex = anime.episodes.findIndex((ep) => ep.nanoid === epNanoid);

// Episodes ordered around current episode
const sortedEpisodes = [
  ...anime.episodes.slice(currentIndex),
  ...anime.episodes.slice(0, currentIndex),
];

const embedUrl = `${url}${url.includes("?") ? "&" : "?"}enablejsapi=1`;

//SeoHead details
const prevSlug = prevObj?.slug;
const nextSlug = nextObj?.slug;
const pageUrl = `${frontendUrl}/episode/${nanoid}/${epNanoid}/${slug}`;
const prevUrl = `${frontendUrl}/episode/${nanoid}/${epNanoid}/${prevSlug}`;
const nextUrl = `${frontendUrl}/episode/${nanoid}/${epNanoid}/${nextSlug}`;
const pageKw = `${animeTitle}, ${episodeTitle}, Episode ${epNum}, ${language}, free anime, HD anime streaming`;
const pageDes = `Watch ${animeTitle} Episode ${epNum} (${episodeTitle}) in HD ${language} — No ads, no popups. ${description.slice(0, 160)}`;
---

<Fragment slot="head">
  <SEOHead
    title={`Watch Ad-Free ${animeTitle} - Episode ${epNum}: ${episodeTitle} | AniKawa`}
    description={pageDes}
    ogDescription={pageDes}
    imageUrl={currentThumbnail}
    url={pageUrl}
    keywords={pageKw}
  >
    {prevObj && <link rel="prev" href={prevUrl} />}
    {nextObj && <link rel="next" href={nextUrl} />}
  </SEOHead>
</Fragment>
<Layout>
  <RecentlyWatchedTracker animenanoid={nanoid} client:idle />
  <article id="main-episode-page" class="main-episode-page">
    <section aria-labelledby="e-title" class="video-container">
      <iframe
        id={`episode-iframe-${epNanoid}`}
        width="560"
        height="315"
        src={embedUrl}
        title="YouTube video player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
      <YouTubeProgressTracker
        client:idle
        animeId={nanoid as string}
        episodeNanoid={episode.nanoid}
      />
    </section>
    <section class="episode-hero-info">
      <div class="episode-kicker">
        <a href={`/show/${nanoid}/${animeslug}`}>{animeTitle}</a>
        <span>•</span>
        <span>Episode {epNum}</span>
        <span>•</span>
        <a href="#comments">See Comments</a>
        <span>•</span>
        <EpisodeVotes episodeId={epNanoid as string} client:idle />
      </div>

      <h1 class="episode-title">
        {episodeTitle}
      </h1>

      <p class="episode-summary">
        {description}
      </p>

      <div class="episode-meta-grid">
        <div class="meta-card">
          <span class="meta-label">Air Date</span>
          <span class="meta-value">
            {air_date}
          </span>
        </div>

        <div class="meta-card">
          <span class="meta-label">Episode Rating</span>
          <span class="meta-value">
            {vote_average?.toFixed(1)} / 10
          </span>
        </div>

        <div class="meta-card">
          <span class="meta-label">Season</span>
          <span class="meta-value">
            {animeTitle}
          </span>
        </div>

        <div class="meta-card">
          <span class="meta-label">Language</span>
          <span class="meta-value">
            {"Japanese Audio"}
          </span>
        </div>
      </div>
    </section>

    <ReactionWidget episodeId={epNanoid as string} client:visible />

    <!-- Episode Navigation Grid -->

    <section class="episode-navigation-section">
      <div class="episode-navigation-header">
        <div>
          <span class="navigation-eyebrow"> EPISODE LIST </span>

          <h2 class="navigation-title">All Episodes</h2>

          <p class="navigation-description">
            Browse all episodes of {animeTitle} and continue watching from where you
            left off.
          </p>
        </div>

        <div class="episode-count-badge">
          {totalEpisodes} Episodes
        </div>
      </div>

      <div class="episode-grid-scroll">
        <div class="episode-grid-container">
          {
            sortedEpisodes.map((ep) => {
              const isCurrent = ep.nanoid === epNanoid;

              return (
                <a
                  href={`/episode/${nanoid}/${ep.nanoid}/${ep.slug}`}
                  class:list={[
                    "episode-grid-card",
                    {
                      "active-episode": isCurrent,
                    },
                  ]}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  <div class="episode-number">
                    {isCurrent && (
                      <span class="playing-badge">NOW PLAYING</span>
                    )}

                    <span>EP {ep.epNum}</span>
                  </div>

                  <div class="episode-grid-content">
                    <h3>{ep.titleAlt || `Episode ${ep.epNum}`}</h3>

                    {ep.air_date && <p>{ep.air_date}</p>}
                  </div>

                  <div class="episode-arrow">→</div>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- EP SUMMARY -->
    {
      summary && (
        <section class="episode-summary-section">
          <div class="episode-summary-header">
            <span class="summary-eyebrow"> EPISODE GUIDE </span>

            <h2 class="summary-title">What Happens In This Episode?</h2>
          </div>

          <div class="episode-summary-card">
            <p>{summary}</p>
          </div>
        </section>
      )
    }

    <!-- Why Ep Matters -->

    {
      importance && (
        <section class="episode-importance-section">
          <div class="importance-header">
            <span class="importance-eyebrow"> STORY INSIGHT </span>

            <h2 class="importance-title">Why This Episode Matters</h2>
          </div>

          <div class="importance-card">
            <p>{importance}</p>
          </div>
        </section>
      )
    }

    <!-- Episode Trivia -->

    {
      facts && (
        <section class="episode-trivia-section">
          <div class="trivia-header">
            <span class="trivia-eyebrow"> DID YOU KNOW? </span>

            <h2 class="trivia-title">Facts about this Episode</h2>
          </div>

          <div class="trivia-card">
            <ul class="trivia-list">
              {facts && facts.map((fact: string) => <li> {fact} </li>)}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Season Progress -->
    <section class="season-progress-section">
      <div class="progress-header">
        <span class="progress-eyebrow"> WATCH PROGRESS </span>

        <h2 class="progress-title">Season Progress</h2>

        <p class="progress-description">
          You're currently watching episode {epNum} of {totalEpisodes}.
        </p>
      </div>

      <div class="progress-card">
        <div class="progress-stats">
          <span> Episode {epNum} </span>

          <span>
            {progressPercentage}% Complete
          </span>
        </div>

        <div class="progress-track">
          <div class="progress-fill" style={`width:${progressPercentage}%`}>
          </div>
        </div>

        <div class="progress-footer">
          <span>Start</span>
          <span>{totalEpisodes} Episodes</span>
        </div>
      </div>
    </section>

    <div id="comments"></div>
    <CommentSection episodeId={epNanoid as string} client:visible />
    <script>
      const hash = window.location.hash;

      if (hash.startsWith("#comment-")) {
        const comments = document.getElementById("comments");

        comments?.scrollIntoView({
          behavior: "auto",
          block: "start",
        });
      }
    </script>
    {
      faq && (
        <section class="anime-faq-section">
          <header class="anime-faq-header">
            {/* <span class="faq-eyebrow">FREQUENTLY ASKED QUESTIONS</span> */}

            <h2 class="anime-faq-title">Questions About this Episode</h2>

            {/* {faq.intro && <p class="anime-faq-description">{faq.intro}</p>} */}
          </header>

          <div class="anime-faq-list">
            {faq.questions.map((item: any) => (
              <details class="anime-faq-item">
                <summary>
                  <span>{item.question}</span>
                  <span class="anime-faq-icon">+</span>
                </summary>

                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Layout>
