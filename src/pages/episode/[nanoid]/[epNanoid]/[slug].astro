---
import "@/styles/episode-pagetw.css";
import { type Anime } from "@/types/mergedListTypes";
import { getAnimeById } from "@/filters/getAnimeById";
import HandleECClick from "@/components/EpisodeCard/EcDatabaseContact/HandleECClick";
import SEOHead from "@/components/SEO/SEOHead.astro";
import { getEpImg } from "@/utils/getEpImgFallback";
import EpisodeChangeCard from "@/components/EpisodeCard/EpisodeChangeCard.astro";
import { frontendUrl } from "@/global_assets/globalPaths";
import Layout from "@/layouts/Layout.astro";
const { nanoid, slug } = Astro.params;
const anime = await getAnimeById(nanoid) as Anime | null;
const episode = anime?.episodes?.find((e) => e?.slug == slug);

if (!anime || !episode || slug == "n-a") {
  return new Response(null, {
    status: 302,
    headers: {
      Location: "/404",
    },
  });
}

//anime details
const {
  slug: animeslug = "n-a",
  title: animeTitle = "Untitled",
  scoreAlt = "Score N/A",
  runtime,
} = anime ?? {};
const language = "Subtitled";

//current episode details
const {
  nanoid: epNanoid,
  epNum,
  url,
  titleAlt: episodeTitle,
  description = "No description",
  ratingLabel,
  air_date,
  vote_average,
  summary,
  importance,
  facts,
} = episode ?? {};

const currentThumbnail = getEpImg(episode);

const totalEpisodes = anime?.episodes.length;
const progressPercentage = ((epNum / totalEpisodes) * 100).toFixed(0);
//to send to episode change cards
const prevObj = anime?.episodes?.[epNum - 2];
const nextObj = anime?.episodes?.[epNum];

const animeDetails = {
  animeTitle,
  nanoid,
  language,
};

//SeoHead details
const prevSlug = prevObj?.slug;
const nextSlug = nextObj?.slug;
const pageUrl = `${frontendUrl}/episode/${nanoid}/${epNanoid}/${slug}`;
const prevUrl = `${frontendUrl}/episode/${nanoid}/${epNanoid}/${prevSlug}`;
const nextUrl = `${frontendUrl}/episode/${nanoid}/${epNanoid}/${nextSlug}`;
const pageKw = `${animeTitle}, ${episodeTitle}, Episode ${epNum}, ${language}, free anime, HD anime streaming`;
const pageDes = `Watch ${animeTitle} Episode ${epNum} (${episodeTitle}) in HD ${language} — No ads, no popups. ${description.slice(0, 160)}`;
---

<Fragment slot="head">
  <SEOHead
    title={`Watch {Ad-Free} ${animeTitle} - Episode ${epNum}: ${episodeTitle} | AniKawa`}
    description={pageDes}
    ogDescription={pageDes}
    imageUrl={currentThumbnail}
    url={pageUrl}
    keywords={pageKw}
  >
    {prevObj && <link rel="prev" href={prevUrl} />}
    {nextObj && <link rel="next" href={nextUrl} />}
  </SEOHead>
</Fragment>
<Layout>
  <article id="main-episode-page" class="main-episode-page">
    <HandleECClick animenanoid={nanoid} slug={slug} client:load />
    <section aria-labelledby="e-title" class="video-container">
      <iframe
        id="episode-iframe"
        width="560"
        height="315"
        src={url}
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;  web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </section>
    <section class="episode-hero-info">
      <div class="episode-kicker">
        <a href={`/show/${nanoid}/${animeslug}`}>{animeTitle}</a>
        <span>•</span>
        <span>Episode {epNum}</span>
      </div>

      <h1 class="episode-title">
        {episodeTitle}
      </h1>

      <p class="episode-summary">
        {description}
      </p>

      <div class="episode-meta-grid">
        <div class="meta-card">
          <span class="meta-label">Air Date</span>
          <span class="meta-value">
            {air_date}
          </span>
        </div>

        <div class="meta-card">
          <span class="meta-label">Episode Rating</span>
          <span class="meta-value">
            {vote_average?.toFixed(1)} / 10
          </span>
        </div>

        <div class="meta-card">
          <span class="meta-label">Season</span>
          <span class="meta-value">
            {animeTitle}
          </span>
        </div>

        <div class="meta-card">
          <span class="meta-label">Language</span>
          <span class="meta-value">
            {"Japanese Audio"}
          </span>
        </div>
      </div>
    </section>

    <!-- EP SUMMARY -->
    {summary && <section class="episode-summary-section">
      <div class="episode-summary-header">
        <span class="summary-eyebrow"> EPISODE GUIDE </span>

        <h2 class="summary-title">What Happens In This Episode?</h2>
      </div>

      <div class="episode-summary-card">
        <p>
          {summary}
        </p>
      </div>
    </section>}

    <!-- Why Ep Matters -->

    {importance && <section class="episode-importance-section">
      <div class="importance-header">
        <span class="importance-eyebrow"> STORY INSIGHT </span>

        <h2 class="importance-title">Why This Episode Matters</h2>
      </div>

      <div class="importance-card"><p>{importance}</p></div>
    </section>}

    <!-- Episode Trivia -->

    {facts && <section class="episode-trivia-section">
      <div class="trivia-header">
        <span class="trivia-eyebrow"> DID YOU KNOW? </span>

        <h2 class="trivia-title">Facts about this Episode</h2>
      </div>

      <div class="trivia-card">
        <ul class="trivia-list">
          {facts && facts.map((fact: string) => <li> {fact} </li>)}
        </ul>
      </div>
    </section>}

    <!-- Watch Next -->
    <article class="episode-page-details">
      <nav class="episode-change-section">
        <EpisodeChangeCard
          Obj={prevObj}
          Obj2={{ h4: "PREVIOUS EPISODE", ...animeDetails }}
        />
        <EpisodeChangeCard
          Obj={nextObj}
          Obj2={{ h4: "NEXT EPISODE", ...animeDetails }}
        />
      </nav>
    </article>

    <!-- Season Progress -->
    <section class="season-progress-section">
      <div class="progress-header">
        <span class="progress-eyebrow"> WATCH PROGRESS </span>

        <h2 class="progress-title">Season Progress</h2>

        <p class="progress-description">
          You're currently watching episode {epNum} of {
            totalEpisodes
          }.
        </p>
      </div>

      <div class="progress-card">
        <div class="progress-stats">
          <span> Episode {epNum} </span>

          <span>
            {progressPercentage}% Complete
          </span>
        </div>

        <div class="progress-track">
          <div class="progress-fill" style={`width:${progressPercentage}%`}>
          </div>
        </div>

        <div class="progress-footer">
          <span>Start</span>
          <span>{totalEpisodes} Episodes</span>
        </div>
      </div>
    </section>
  </article>
</Layout>
