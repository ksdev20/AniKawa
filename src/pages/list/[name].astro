---
import { validNames, listConfig, filterMap } from "../../config/listConfig";
import "../../styles/new-poptw.css";
import "../../styles/lists/n-p-a-l.css";
import SEOHead from "../../components/SEO/SEOHead.astro";
import NewPopButtons from "../../components/ButtonHandlers/NewPopButtons";
import AnimeCardStatic from "../../components/AnimeCard/AnimeCardStaticTmdbVer.astro";
import Layout from "../../layouts/Layout.astro";

const { name } = Astro.params;
const urlFilter = Astro.url.searchParams.get("filter") ?? "all";

// ✅ Redirect if invalid list name
if (!name || !validNames.includes(name as "new" | "old" | "popular")) {
  return Astro.redirect("/404");
}

// ✅ Await async config
const configs = await listConfig();
const currentConfig = configs.find((i) => i.name === name);

if (!currentConfig) {
  return Astro.redirect("/404");
}

const {
  srOnly,
  label,
  animeList,
  pageTitle,
  pageDescription,
  keywords,
  pageUrl,
  backdrop,
} = currentConfig;

const filterFn = filterMap[urlFilter] ?? filterMap["all"];
const finalArray = animeList.filter(filterFn);
---

<Fragment slot="head">
  <SEOHead
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    ogDescription={pageDescription}
    url={pageUrl}
    imageUrl={backdrop}
  />
</Fragment>
<Layout>
  <main class="main-root">
    <div id="banner-ad-1" class="banner-ad-container"></div>
    <div id="banner-ad-2" class="banner-ad-container"></div>
    <section class="main-content" aria-labelledby="anime-list-heading">
      <header class="new-first">
        <h1 class="new-first-heading">{label}</h1>
        <NewPopButtons listName={name} client:load />
      </header>
      <section>
        <h2 class="sr-only">{srOnly}</h2>
        <ul class="new-pop-anime-list">
          {
            finalArray.map((anime) => (
              <AnimeCardStatic anime={anime} forNewPop={true} />
            ))
          }
        </ul>
        <div id="banner-ad-3" class="banner-ad-container"></div>
      </section>
    </section>
  </main>
</Layout>
