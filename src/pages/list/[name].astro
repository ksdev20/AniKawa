---
import { validNames, listConfig, filterMap } from "../../config/listConfig";
import "../../styles/new-poptw.css";
import "../../styles/lists/n-p-a-l.css";
import SEOHead from "../../components/SEO/SEOHead.astro";
import NewPopButtons from "../../components/ButtonHandlers/NewPopButtons";
import AnimeCardStatic from "../../components/AnimeCard/AnimeCardStaticTmdbVer.astro";
import Layout from "../../layouts/Layout.astro";

const { name } = Astro.params;
const urlFilter = Astro.url.searchParams.get("filter") ?? "all";

//redirect to /404 if not the valid name for which this page is configured
if (!name || !validNames.includes(name as string)) {
  return new Response(null, {
    status: 302,
    headers: {
      Location: "/404",
    },
  });
}

//values assignment as per config
const currentConfig = listConfig.find((i) => i.name == name);
const {
  srOnly,
  label,
  animeList,
  pageTitle,
  pageDescription,
  keywords,
  pageUrl,
  backdrop,
} = currentConfig ?? {};
const filterFn = filterMap[urlFilter];

const finalArray = animeList?.filter(filterFn);
---

<Fragment slot="head">
  <SEOHead
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    ogDescription={pageDescription}
    url={pageUrl}
    imageUrl={backdrop}
  />
</Fragment>
<Layout>
  <main class="main-root">
    <section class="main-content" aria-labelledby="anime-list-heading">
      <header class="new-first">
        <h1 class="new-first-heading">{label}</h1>
        <NewPopButtons listName={name} client:load />
      </header>
      <section>
        <h2 class="sr-only">{srOnly}</h2>
        <ul class="new-pop-anime-list">
          {
            finalArray?.map((anime) => {
              return <AnimeCardStatic anime={anime} forNewPop={true} />;
            })
          }
        </ul>
      </section>
    </section>
  </main>
</Layout>