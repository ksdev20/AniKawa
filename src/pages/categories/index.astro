---
import SEOHead from "../../components/SEO/SEOHead.astro";
import Layout from "../../layouts/Layout.astro";
import "../../styles/pages/categories/categories.css";

const categories = [
  {
    name: "Action",
    emoji: "⚔️",
    desc: "Explosive battles, powerful heroes, and unforgettable fights.",
    href: "/category/Action",
  },
  {
    name: "Adventure",
    emoji: "🗺️",
    desc: "Journey across exciting worlds filled with discovery.",
    href: "/category/Adventure",
  },
  {
    name: "Comedy",
    emoji: "😂",
    desc: "Laugh-out-loud anime packed with humor and fun moments.",
    href: "/category/Comedy",
  },
  {
    name: "Drama",
    emoji: "🎭",
    desc: "Emotional stories driven by compelling characters.",
    href: "/category/Drama",
  },
  {
    name: "Fantasy",
    emoji: "✨",
    desc: "Magic, kingdoms, myths, and extraordinary adventures.",
    href: "/category/Fantasy",
  },
  {
    name: "Music",
    emoji: "🎵",
    desc: "Bands, idols, performances, and inspiring musical journeys.",
    href: "/category/Music",
  },
  {
    name: "Romance",
    emoji: "❤️",
    desc: "Heartwarming relationships and unforgettable love stories.",
    href: "/category/Romance",
  },
  {
    name: "Sci-Fi",
    emoji: "🚀",
    desc: "Futuristic worlds, technology, and mind-bending concepts.",
    href: "/category/Sci-fi",
  },
  {
    name: "Sports",
    emoji: "🏀",
    desc: "Competition, teamwork, growth, and thrilling matches.",
    href: "/category/Sports",
  },
  {
    name: "Supernatural",
    emoji: "👻",
    desc: "Ghosts, spirits, powers, and mysterious phenomena.",
    href: "/category/Supernatural",
  },
  {
    name: "Thriller",
    emoji: "🔪",
    desc: "Suspenseful stories packed with tension and twists.",
    href: "/category/Thriller",
  },
];

const title = "Browse Anime Categories & Find Your Next Anime | AniKawa";

const pageDes =
  "Discover anime by category, genre, mood, and theme. Find action anime, romance anime, fantasy adventures, hidden gems, beginner-friendly series, thrillers, and more on AniKawa.";

const pageKw =
  "browse anime, anime categories, anime genres, anime recommendations, anime finder, action anime, romance anime, fantasy anime, mystery anime, slice of life anime, best anime to watch";

const pageUrl = "https://anikawa.fun/categories";

const currentThumbnail =
  "https://ik.imagekit.io/anikawa/Page%20Images/categories-page-thumbnail.avif";
---

<Fragment slot="head">
  <SEOHead
    title={title}
    description={pageDes}
    ogDescription={pageDes}
    imageUrl={currentThumbnail}
    url={pageUrl}
    keywords={pageKw}
  />
</Fragment>
<Layout title="Anime Categories | AniKawa">
  <div id="banner-ad-1" class="banner-ad-container"></div>
  <!-- Hero -->
  <section class="categories-hero">
    <div class="categories-container">
      <span class="section-badge"> 🎌 Anime Genres </span>

      <h1 class="categories-title">Browse Anime By Genre</h1>

      <p class="categories-subtitle">
        Discover anime based on the genres you love. Whether you're looking for
        action-packed adventures, emotional dramas, fantasy worlds, romance,
        sports, or sci-fi stories, AniKawa helps you find your next favorite
        anime.
      </p>
    </div>
  </section>

  <!-- Categories Grid -->

  <section class="genre-grid-section">
    <div class="categories-container">
      <div class="genre-grid">
        {
          categories.map((category) => (
            <a href={category.href} class="genre-card">
              <div class="genre-card-icon">{category.emoji}</div>

              <h2 class="genre-card-title">{category.name}</h2>

              <p class="genre-card-description">{category.desc}</p>

              <span class="genre-card-link">Explore →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div id="banner-ad-2" class="banner-ad-container"></div>
  <!-- CTA -->

  <section class="categories-cta">
    <div class="categories-container">
      <div class="categories-cta-card">
        <h2>Can't Decide What To Watch?</h2>

        <p>
          Explore editor's picks, trending anime, community favorites, and
          curated recommendations from AniKawa.
        </p>

        <a href="/blog" class="categories-cta-button"> Browse Anikawa Blog </a>
      </div>
    </div>
  </section>

  <!-- SEO Content -->

  <section class="genres-about-section">
    <div class="categories-container">
      <div class="genres-about-card">
        <span class="section-badge"> 📖 About Anime Genres </span>

        <h2 class="section-title">Understanding Anime Genres</h2>

        <p>
          Anime genres help viewers discover series that match their interests
          and preferences. Action anime focus on exciting battles and fast-paced
          stories, while romance anime explore relationships and emotional
          connections. Fantasy anime transport viewers to magical worlds, and
          sci-fi anime imagine futuristic technology and possibilities.
        </p>

        <p>
          Other genres offer completely different experiences. Sports anime
          highlight competition and teamwork, comedy anime deliver laughs and
          lighthearted fun, and thriller anime keep viewers on the edge of their
          seats. Exploring different genres is one of the best ways to discover
          new anime and expand your watchlist.
        </p>

        <p>
          At AniKawa, you can browse anime by genre, discover recommendations,
          explore detailed anime guides, and find series tailored to your
          interests.
        </p>
      </div>
    </div>
  </section>
</Layout>
